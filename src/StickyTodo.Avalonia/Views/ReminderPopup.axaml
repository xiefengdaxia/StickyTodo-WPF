<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:StickyTodo.Notes.Localization"
        x:Class="StickyTodo.Notes.Views.ReminderPopup"
        Title="{loc:Loc reminder.title}"
        Width="300"
        SizeToContent="Height"
        CanResize="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True">

  <Border Name="Shell" Classes="note">
    <StackPanel Margin="14">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="⏰" FontSize="14" VerticalAlignment="Center" />
        <TextBlock Text="{loc:Loc reminder.heading}" Margin="6,0,0,0" FontWeight="SemiBold"
                   VerticalAlignment="Center" Foreground="{DynamicResource Brush.Ink}" />
        <TextBlock Name="TimeText" Classes="caption" VerticalAlignment="Center" Margin="8,0,0,0" />
      </StackPanel>

      <TextBlock Name="TitleText" Margin="0,10,0,0" FontSize="14" TextWrapping="Wrap"
                 Foreground="{DynamicResource Brush.Ink}" />

      <TextBlock Name="BoardText" Classes="caption" Margin="0,6,0,0" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button Content="{loc:Loc reminder.snooze}" Classes="ghost" Click="Snooze_Click" />
        <Button Content="{loc:Loc reminder.dismiss}" Classes="primary" Margin="8,0,0,0" Click="Ok_Click" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
