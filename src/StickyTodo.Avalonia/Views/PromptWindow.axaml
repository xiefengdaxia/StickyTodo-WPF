<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:StickyTodo.Notes.Localization"
        x:Class="StickyTodo.Notes.Views.PromptWindow"
        Width="380"
        SizeToContent="Height"
        CanResize="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Topmost="True">

  <Border Name="Shell" Classes="note" Margin="12" CornerRadius="12">
    <StackPanel Margin="18,16,18,16">
      <Grid Name="TitleBar" Background="Transparent">
        <TextBlock Name="LabelText"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Ink}"
                   VerticalAlignment="Center" />
        <Button Classes="chrome" HorizontalAlignment="Right" Content="✕" FontSize="10" Click="Cancel_Click" />
      </Grid>

      <TextBox Name="Input" Classes="flat" Margin="0,12,0,0" />

      <TextBlock Name="ErrorText"
                 Margin="2,8,0,0"
                 FontSize="11"
                 Foreground="{DynamicResource Brush.Danger}"
                 IsVisible="False"
                 TextWrapping="Wrap" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Content="{loc:Loc common.cancel}" Classes="ghost" Click="Cancel_Click" />
        <Button Content="{loc:Loc common.ok}" Classes="primary" Margin="8,0,0,0" Click="Ok_Click" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
