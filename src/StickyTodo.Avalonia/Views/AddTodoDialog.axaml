<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:StickyTodo.Notes.Localization"
        x:Class="StickyTodo.Notes.Views.AddTodoDialog"
        Width="400"
        SizeToContent="Height"
        CanResize="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Topmost="True">

  <Border Name="Shell" Classes="note" Margin="12" CornerRadius="12">
    <StackPanel Margin="18,16,18,16">
      <Grid Name="TitleBar" Background="Transparent">
        <TextBlock Name="LabelText"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Ink}"
                   VerticalAlignment="Center" />
        <Button Classes="chrome" HorizontalAlignment="Right" Content="✕" FontSize="10" Click="Cancel_Click" />
      </Grid>

      <TextBox Name="Input" Classes="flat" Margin="0,12,0,0" />

      <!-- 时间点：两个下拉框（时 / 分），勾选提醒才启用 -->
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*" Margin="0,10,0,0">
        <CheckBox Name="RemindCheck" VerticalAlignment="Center" Classes="labeled"
                  Content="{loc:Loc cal.addTimeLabel}"
                  Checked="RemindCheck_Changed" Unchecked="RemindCheck_Changed" />
        <ComboBox Name="HourBox" Grid.Column="1" Width="64" Margin="8,0,0,0"
                  VerticalAlignment="Center" Classes="flat"
                  SelectionChanged="Time_Changed" />
        <TextBlock Grid.Column="2" Text=":" FontSize="14" Margin="4,0,4,0"
                   VerticalAlignment="Center" Foreground="{DynamicResource Brush.InkSoft}" />
        <ComboBox Name="MinuteBox" Grid.Column="3" Width="64"
                  VerticalAlignment="Center" Classes="flat"
                  SelectionChanged="Time_Changed" />
        <TextBlock Grid.Column="4" Name="AllDayText"
                   Text="{loc:Loc cal.allDay}"
                   FontSize="11" Opacity="0.65" Margin="8,0,0,0"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.InkSoft}" />
      </Grid>

      <TextBlock Name="ErrorText"
                 Margin="2,8,0,0"
                 FontSize="11"
                 Foreground="{DynamicResource Brush.Danger}"
                 IsVisible="False"
                 TextWrapping="Wrap" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0" Spacing="8">
        <Button Content="{loc:Loc common.cancel}" Classes="ghost" Click="Cancel_Click" />
        <Button Content="{loc:Loc common.ok}" Classes="primary" Click="Ok_Click" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
