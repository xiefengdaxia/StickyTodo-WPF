<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StickyTodo.Notes.Views.UnlockChipWindow"
        Title="解锁"
        Width="30" Height="30"
        CanResize="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True">

  <!-- 锁定的看板是鼠标穿透的，只有这个小徽标还能点：点一下解锁 -->
  <Border Name="Chip"
          Width="26" Height="26"
          CornerRadius="13"
          Background="{DynamicResource Brush.Accent}"
          BorderBrush="#66FFFFFF"
          BorderThickness="1"
          Cursor="Hand"
          ToolTip.Tip="点击解锁（看板已锁定，鼠标穿透）"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          PointerReleased="Chip_Click">
    <TextBlock Text="🔓"
               FontSize="12"
               HorizontalAlignment="Center"
               VerticalAlignment="Center" />
  </Border>
</Window>