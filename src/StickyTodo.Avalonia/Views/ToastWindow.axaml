<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:StickyTodo.Notes.Localization"
        x:Class="StickyTodo.Notes.Views.ToastWindow"
        Title="StickyTodo"
        Width="280"
        SizeToContent="Height"
        CanResize="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True">

  <Border Name="Shell" Classes="note">
    <StackPanel Margin="14">
      <TextBlock Name="HeadingText" FontWeight="SemiBold" FontSize="13"
                 Foreground="{DynamicResource Brush.Ink}" TextWrapping="Wrap" />
      <TextBlock Name="BodyText" Margin="0,6,0,0" FontSize="12"
                 Foreground="{DynamicResource Brush.InkSoft}" TextWrapping="Wrap" />
      <Button Content="{loc:Loc common.ok}" Classes="primary" HorizontalAlignment="Right"
              Margin="0,12,0,0" Padding="16,6" Click="Ok_Click" />
    </StackPanel>
  </Border>
</Window>
