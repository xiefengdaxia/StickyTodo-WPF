<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StickyTodo.Notes.ViewModels"
        x:Class="StickyTodo.Notes.Views.DesktopClockBoardWindow"
        Title="桌面时钟"
        Width="300"
        SizeToContent="Height"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        CanResize="False"
        ShowInTaskbar="False"
        TransparencyBackgroundFallback="#F02F2A26"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True">

  <Window.Styles>
    <!-- 可点击的一行：悬停时淡淡亮一下，提示"这里能点" -->
    <Style Selector="Border.clockRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="3,2" />
      <Setter Property="Margin" Value="-3,0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.clockRow:pointerover">
      <Setter Property="Background" Value="#1AFFFFFF" />
    </Style>
  </Window.Styles>

  <Border Name="NoteRoot" Background="#F02F2A26" CornerRadius="12"
          BorderBrush="#59FFFFFF" BorderThickness="1"
          BoxShadow="0 3 16 0 #59000000">
    <StackPanel Margin="16,12,16,14"
                PointerPressed="Root_PointerPressed"
                PointerMoved="Root_PointerMoved"
                PointerReleased="Root_PointerReleased">

      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding SolarDateText}" FontSize="15" FontWeight="SemiBold"
                   Foreground="#FFF0E6D8" />
        <TextBlock Grid.Column="1" Text="{Binding WeekdayText}" FontSize="13"
                   Foreground="#FFCFC3B4" />
      </Grid>

      <!-- 农历 + 节气/节日 -->
      <TextBlock Text="{Binding LunarText}" FontSize="11.5" Foreground="#FF9E9284" Margin="0,4,0,0"
                 TextTrimming="CharacterEllipsis" />

      <TextBlock Text="{Binding TimeText}" FontSize="38" FontWeight="Light"
                 Foreground="#FFF6EFE4" Margin="0,4,0,0" />

      <Border Height="1" Background="#26FFFFFF" Margin="0,10,0,8" />

      <!-- 天气（点一下打开天气看板） -->
      <Border Classes="clockRow" ToolTip.Tip="点击打开天气看板"
              PointerPressed="WeatherRow_PointerPressed"
              PointerReleased="WeatherRow_PointerReleased">
        <Grid ColumnDefinitions="Auto,*">
          <TextBlock Grid.Column="0" Text="{Binding WeatherLine}" FontSize="12.5"
                     Foreground="#FFE8A85C" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding WeatherDetail}" FontSize="11"
                     Foreground="#FF9E9284" Margin="8,0,0,0" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
        </Grid>
      </Border>

      <!-- 今日日程（点一下打开日历） -->
      <Border Classes="clockRow" Margin="-3,3" ToolTip.Tip="点击打开日历"
              PointerPressed="AgendaRow_PointerPressed"
              PointerReleased="AgendaRow_PointerReleased">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding AgendaLine}" FontSize="12"
                     Foreground="#FFD9CEC0" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="1" Text="{Binding AgendaDetail}" FontSize="11"
                     Foreground="#FF9E9284" Margin="8,0,0,0" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Button Classes="chrome" Content="✕" FontSize="10" HorizontalAlignment="Right"
              Margin="0,6,0,0" Click="Close_Click" />
    </StackPanel>
  </Border>
</Window>
