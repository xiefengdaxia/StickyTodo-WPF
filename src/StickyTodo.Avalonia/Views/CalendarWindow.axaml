<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:StickyTodo.Notes.Localization"
        xmlns:conv="using:StickyTodo.Notes.Converters"
        xmlns:vm="using:StickyTodo.Notes.ViewModels"
        x:Class="StickyTodo.Notes.Views.CalendarWindow"
        Title="{Binding BoardName}"
        Width="520" Height="620"
        MinWidth="420" MinHeight="460"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        CanResize="True"
        ShowInTaskbar="False"
        Opacity="{Binding WindowOpacity}"
        Topmost="{Binding IsTopmost}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True">

  <Window.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <conv:LocalizedYearConverter x:Key="LocYear" />
    <conv:LocalizedMonthConverter x:Key="LocMonth" />
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock.pin">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="TextBlock.pin.active">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.cell">
      <Setter Property="Margin" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.cell:pointerover">
      <Setter Property="Background" Value="#1FB27F0A" />
    </Style>
    <Style Selector="Border.cell.today">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
      <Setter Property="Background" Value="#2EB27F0A" />
    </Style>
    <Style Selector="Border.cell.otherMonth">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
  </Window.Styles>

  <Border Name="NoteRoot" Classes="note">
    <Grid RowDefinitions="Auto,*,Auto">

      <Border Name="TitleBar" Classes="header" CornerRadius="11,11,0,0" Padding="12,8">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding BoardName}" Classes="title" TextTrimming="CharacterEllipsis" />
              <TextBlock Text=" 🔒" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding IsLocked}" />
            </StackPanel>
            <TextBlock Text="{Binding StatusText}" Classes="caption" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
            <Button Classes="chrome" ToolTip.Tip="{loc:Loc chrome.topmost}" Click="ToggleTopmost_Click">
              <TextBlock Text="📌" FontSize="11" Classes="pin" Classes.active="{Binding IsTopmost}" />
            </Button>
            <Button Classes="chrome" ToolTip.Tip="{loc:Loc chrome.lock}" Click="ToggleLock_Click">
              <Panel>
                <TextBlock FontSize="11" Text="🔓" IsVisible="{Binding !IsLocked}" />
                <TextBlock FontSize="11" Text="🔒" IsVisible="{Binding IsLocked}" />
              </Panel>
            </Button>
            <Button Classes="chrome" Content="🎨" FontSize="11"
                    ToolTip.Tip="{loc:Loc chrome.appearance}" Click="Appearance_Click" />
            <Button Classes="chrome" Content="⋯" FontSize="13"
                    ToolTip.Tip="{loc:Loc chrome.manage}" Click="OpenManager_Click" />
            <Button Classes="chrome" Content="✕" FontSize="11"
                    ToolTip.Tip="{loc:Loc chrome.close}" Click="Close_Click" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="10,8,10,0" RowDefinitions="Auto,Auto,*">

        <Grid Grid.Row="0" Margin="2,0,2,6" ColumnDefinitions="Auto,Auto,Auto,Auto,*">
          <Button Grid.Column="0" Content="‹" Classes="ghost" Padding="10,2"
                  ToolTip.Tip="{loc:Loc cal.prevMonth}" Click="PrevMonth_Click" />

          <ComboBox Name="YearBox" Grid.Column="1" Classes="flat" Width="86" Margin="8,0,0,0"
                    VerticalAlignment="Center" ItemsSource="{Binding Years}"
                    SelectedItem="{Binding Year, Mode=OneWay}"
                    SelectionChanged="YearBox_SelectionChanged">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Converter={StaticResource LocYear}}" FontSize="11" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <ComboBox Name="MonthBox" Grid.Column="2" Classes="flat" Width="62" Margin="4,0,0,0"
                    VerticalAlignment="Center" ItemsSource="{Binding Months}"
                    SelectedItem="{Binding Month, Mode=OneWay}"
                    SelectionChanged="MonthBox_SelectionChanged">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Converter={StaticResource LocMonth}}" FontSize="11" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <Button Grid.Column="3" Content="›" Classes="ghost" Padding="10,2" Margin="4,0,0,0"
                  ToolTip.Tip="{loc:Loc cal.nextMonth}" Click="NextMonth_Click" />

          <Button Grid.Column="4" Content="{loc:Loc common.today}" HorizontalAlignment="Right"
                  Classes="ghost" Padding="10,2" FontSize="11" Click="Today_Click" />
        </Grid>

        <ItemsControl Grid.Row="1" Margin="0,0,0,4" ItemsSource="{Binding WeekHeaders}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="7" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" Classes="caption" HorizontalAlignment="Center" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding Days}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="7" Rows="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CalendarDayViewModel">
              <Border Classes="cell"
                      Classes.today="{Binding IsToday}"
                      Classes.otherMonth="{Binding !IsCurrentMonth}"
                      Tag="{Binding}"
                      PointerPressed="Cell_PointerPressed"
                      DragDrop.AllowDrop="True"
                      DragDrop.DragOver="Cell_DragOver"
                      DragDrop.Drop="Cell_Drop">
                <StackPanel Margin="4,2">
                  <Grid>
                    <TextBlock Text="{Binding DayText}" FontSize="11" HorizontalAlignment="Left"
                               Foreground="{DynamicResource Brush.Ink}" />
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="2"
                            Padding="2,0" Background="{DynamicResource Brush.Danger}"
                            IsVisible="{Binding HasBadge}">
                      <TextBlock Text="{Binding Badge}" FontSize="8" Foreground="White" />
                    </Border>
                  </Grid>
                  <TextBlock Text="{Binding SubText}" FontSize="8.5" Margin="0,1,0,0"
                             HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource Brush.InkSoft}" Opacity="0.8" />
                  <StackPanel Orientation="Horizontal" Margin="0,2,0,0" IsVisible="{Binding HasEntries}">
                    <Ellipse Width="5" Height="5" VerticalAlignment="Center"
                             Fill="{DynamicResource Brush.Accent}" />
                    <TextBlock Text="{Binding Summary}" FontSize="9" Margin="4,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Brush.Accent}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>

      <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0"
              Margin="0,8,0,0" Padding="10,6" Background="#14FFFFFF">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto">

          <TextBlock Grid.Row="0" Text="{Binding SelectedDateText}" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.Ink}" Margin="2,0,0,4" TextWrapping="Wrap" />

          <Border Grid.Row="1" Margin="0,0,0,6" Padding="8,5" CornerRadius="6" Background="#10B27F0A"
                  IsVisible="{Binding ShowAlmanac}">
            <StackPanel>
              <TextBlock Text="{Binding AlmanacDateText}" FontSize="10"
                         Foreground="{DynamicResource Brush.InkSoft}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding AlmanacMetaText}" FontSize="10" Margin="0,2,0,0"
                         Foreground="{DynamicResource Brush.Accent}" TextWrapping="Wrap"
                         IsVisible="{Binding AlmanacMetaText, Converter={StaticResource NullToCollapsed}}" />
              <TextBlock Text="{Binding AlmanacYiText}" FontSize="10.5" Margin="0,4,0,0"
                         TextWrapping="Wrap" Foreground="{DynamicResource Brush.Success}" />
              <TextBlock Text="{Binding AlmanacJiText}" FontSize="10.5" Margin="0,2,0,0"
                         TextWrapping="Wrap" Foreground="{DynamicResource Brush.Danger}" />
            </StackPanel>
          </Border>

          <ScrollViewer Grid.Row="2" MaxHeight="110" VerticalScrollBarVisibility="Auto">
            <ItemsControl Name="DayEntryList" ItemsSource="{Binding SelectedDayEntries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="1" Padding="4,3" CornerRadius="6" Background="Transparent" Cursor="Hand"
                          Tag="{Binding}"
                          PointerPressed="Entry_PointerPressed">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <CheckBox Grid.Column="0" Classes="round" Margin="0,0,7,0" VerticalAlignment="Center"
                                IsChecked="{Binding IsDone, Mode=OneWay}"
                                Click="EntryCheck_Click" Tag="{Binding}" />

                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding TimeText}" FontSize="10"
                                     Foreground="{DynamicResource Brush.Accent}" Margin="0,0,5,0" />
                          <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource Brush.Ink}" />
                          <TextBlock Text="{Binding BoardTag}" FontSize="9" Margin="5,0,0,0"
                                     VerticalAlignment="Center" Foreground="{DynamicResource Brush.Success}" />
                        </StackPanel>
                      </StackPanel>

                      <Button Grid.Column="2" Content="✕" FontSize="10" Classes="link"
                              ToolTip.Tip="{loc:Loc common.delete}"
                              Tag="{Binding}" Click="DeleteEntry_Click" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <TextBlock Grid.Row="2" Text="{loc:Loc cal.noEntries}" Classes="caption"
                     HorizontalAlignment="Center" Margin="0,6,0,6" IsHitTestVisible="False"
                     IsVisible="{Binding !HasSelectedEntries}" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
