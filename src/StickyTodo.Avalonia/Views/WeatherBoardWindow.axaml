<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:StickyTodo.Notes.Localization"
        xmlns:vm="using:StickyTodo.Notes.ViewModels"
        xmlns:wx="using:StickyTodo.Weather"
        x:Class="StickyTodo.Notes.Views.WeatherBoardWindow"
        Title="天气"
        Width="880" Height="700"
        MinWidth="640" MinHeight="480"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True">

  <Window.Styles>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.InkSoft}" />
    </Style>
    <Style Selector="Button.cityTab">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
      <Setter Property="Padding" Value="18,5" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Root" CornerRadius="4" Background="{TemplateBinding Background}">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.cityTab:selected">
      <Setter Property="Background" Value="#FF2C3E50" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.cityAction">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Root" CornerRadius="4" Background="{TemplateBinding Background}"
                  Opacity="{TemplateBinding Opacity}">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.cityAction:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="Border.metric">
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="#11FFFFFF" />
      <Setter Property="Margin" Value="4,0" />
    </Style>

    <!-- 城市模糊搜索下拉 -->
    <Style Selector="ListBox.suggestions ListBoxItem">
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="ListBox.suggestions ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#14000000" />
    </Style>
    <Style Selector="ListBox.suggestions ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
    </Style>
  </Window.Styles>

  <Border Name="NoteRoot" Classes="note">
    <Grid RowDefinitions="Auto,*">

      <Border Name="TitleBar" Classes="header" CornerRadius="11,11,0,0" Padding="12,8"
              PointerPressed="TitleBar_PointerPressed">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="🌤" FontSize="12" VerticalAlignment="Center" />
            <TextBlock Text="天气" Classes="title" Margin="6,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Classes="chrome" Content="🎨" FontSize="11" ToolTip.Tip="{loc:Loc chrome.appearance}"
                    Click="Appearance_Click" />
            <Button Classes="chrome" Content="✕" FontSize="11" ToolTip.Tip="{loc:Loc chrome.close}" Click="Close_Click" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="18,12,18,14" RowDefinitions="Auto,Auto,Auto,Auto,*">

        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="所有城市" Classes="h2" VerticalAlignment="Top" Margin="0,8,10,0" />
          <ItemsControl Grid.Column="1" ItemsSource="{Binding Cities}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:WeatherCityRow">
                <Button Classes="cityTab" Classes.selected="{Binding IsSelected}"
                        Content="{Binding DisplayName}" Click="City_Click" Tag="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>

        <Grid Grid.Row="1" Margin="58,0,2,10" ColumnDefinitions="Auto,Auto,Auto,Auto,*">
          <Grid Grid.Column="0" Width="190">
            <TextBox x:Name="NewCityBox" Classes="flat" FontSize="12" Padding="10,5"
                     Text="{Binding NewCityName}" Watermark="城市名，如 长沙 / 浏阳"
                     TextChanged="NewCity_TextChanged" KeyDown="NewCity_KeyDown" />

            <!-- 模糊搜索下拉：输一个字就按省市区县表给候选 -->
            <Popup x:Name="CityPopup" Placement="Bottom" IsLightDismissEnabled="True" IsOpen="False">
              <Border Width="250" MaxHeight="250" Margin="0,0,10,10" Padding="4" CornerRadius="8"
                      Background="{DynamicResource Brush.Surface}"
                      BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                      BoxShadow="0 2 12 0 #40000000">
                <ListBox x:Name="CitySuggestionList" Classes="suggestions" MaxHeight="240"
                         Background="Transparent" BorderThickness="0"
                         SelectionChanged="CitySuggestion_SelectionChanged">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="wx:DivisionSuggestion">
                      <TextBlock Text="{Binding Label}" FontSize="12"
                                 TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>
            </Popup>
          </Grid>

          <Button Grid.Column="1" Classes="primary" Content="添加" Margin="8,0,0,0" Padding="14,5"
                  FontSize="12" Click="AddCity_Click" />
          <Button Grid.Column="2" Classes="ghost" Content="设为默认" Margin="6,0,0,0" Padding="14,5"
                  FontSize="12" ToolTip.Tip="桌面时钟优先显示这个城市"
                  Command="{Binding SetDefaultCityFromUiCommand}" />
          <Button Grid.Column="3" Classes="ghost" Content="移除当前" Margin="6,0,0,0" Padding="14,5"
                  FontSize="12" IsEnabled="{Binding CanRemoveCity}" Command="{Binding RemoveCityCommand}" />
          <TextBlock Grid.Column="4" Text="{Binding NoticeText}" Classes="caption"
                     VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
        </Grid>

        <Grid Grid.Row="2" Margin="2,0,2,10" ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal">
            <TextBlock Text="📍" FontSize="13" VerticalAlignment="Center" />
            <TextBlock Text="{Binding CurrentCity}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Ink}" Margin="6,0,0,0" />
            <TextBlock Text="{Binding CurrentCityNote}" Classes="caption" Margin="4,0,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <TextBlock Text="{Binding UpdatedText}" Classes="caption" VerticalAlignment="Center" />
            <Button Classes="chrome" Content="⟳" FontSize="13" VerticalAlignment="Center"
                    Margin="6,0,0,0" Command="{Binding LoadCommand}" />
          </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Margin="2,0,2,16">
          <TextBlock Text="实时天气" Classes="h2" Margin="0,0,0,10" />
          <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
            <TextBlock Text="{Binding CurrentIcon}" FontSize="46" VerticalAlignment="Center"
                       Margin="0,0,14,0" Foreground="#FFFFB300" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{Binding CurrentTempText}" FontSize="40" FontWeight="Light"
                         Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding CurrentText}" FontSize="14"
                         Foreground="{DynamicResource Brush.InkSoft}"
                         VerticalAlignment="Bottom" Margin="10,0,0,10" />
            </StackPanel>
            <UniformGrid Grid.Column="2" Columns="4" VerticalAlignment="Center">
              <Border Classes="metric">
                <StackPanel>
                  <TextBlock Text="空气质量" Classes="caption" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding AirQualityText}" FontSize="15" HorizontalAlignment="Center"
                             Foreground="{DynamicResource Brush.Ink}" Margin="0,6,0,0" />
                </StackPanel>
              </Border>
              <Border Classes="metric">
                <StackPanel>
                  <TextBlock Text="空气指数" Classes="caption" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding AirQualityIndexText}" FontSize="15" HorizontalAlignment="Center"
                             Foreground="{DynamicResource Brush.Ink}" Margin="0,6,0,0" />
                </StackPanel>
              </Border>
              <Border Classes="metric">
                <StackPanel>
                  <TextBlock Text="风力" Classes="caption" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding CurrentWind}" FontSize="15" HorizontalAlignment="Center"
                             Foreground="{DynamicResource Brush.Ink}" Margin="0,6,0,0" />
                </StackPanel>
              </Border>
              <Border Classes="metric">
                <StackPanel>
                  <TextBlock Text="湿度" Classes="caption" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding HumidityText}" FontSize="15" HorizontalAlignment="Center"
                             Foreground="{DynamicResource Brush.Ink}" Margin="0,6,0,0" />
                </StackPanel>
              </Border>
            </UniformGrid>
          </Grid>
        </StackPanel>

        <StackPanel Grid.Row="4">
          <TextBlock Text="天气预报" Classes="h2" Margin="0,0,0,10" />          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Days}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WeatherDayRow">
                  <StackPanel Margin="2,0" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding DayLabel}" FontSize="14" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush.Ink}" />
                    <TextBlock Text="{Binding DateLabel}" Classes="caption" HorizontalAlignment="Center" Margin="0,2,0,8" />
                    <TextBlock Text="{Binding IconGlyph}" FontSize="26" HorizontalAlignment="Center" Foreground="#FFFFB300" />
                    <TextBlock Text="{Binding Text}" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush.Ink}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding TempMaxText}" FontSize="13" HorizontalAlignment="Center"
                               Foreground="#FFE67E22" Margin="0,14,0,0" />
                    <TextBlock Text="{Binding TempMinText}" FontSize="13" HorizontalAlignment="Center"
                               Foreground="#FF3498DB" Margin="0,18,0,0" />
                    <TextBlock Text="{Binding IconGlyph2}" FontSize="26" HorizontalAlignment="Center"
                               Foreground="#FFFFB300" Margin="0,14,0,0" />
                    <TextBlock Text="{Binding Text}" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush.Ink}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding Wind}" Classes="caption" HorizontalAlignment="Center" Margin="0,4,0,0" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
        <!-- 天气内容区（第 3~4 行）：加载中 / 失败时盖一层，城市栏仍可点击 -->
        <Border Grid.Row="3" Grid.RowSpan="2" Background="{DynamicResource Brush.PaperOpaque}"
                IsVisible="{Binding IsBusyOverlayVisible}">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="{Binding BusyText}" FontSize="15" MaxWidth="520" TextWrapping="Wrap"
                       TextAlignment="Center" Foreground="{DynamicResource Brush.InkSoft}"
                       HorizontalAlignment="Center" />
            <Button Content="重试" Classes="primary" Margin="0,14,0,0"
                    HorizontalAlignment="Center" Command="{Binding LoadCommand}" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
