<Window x:Class="StickyTodo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StickyTodo"
        Height="580" Width="430"
        MinHeight="380" MinWidth="360"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Paper}"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 头部：标题 + 会员状态徽标 -->
        <Border Grid.Row="0" Background="{StaticResource Brush.PaperDeep}" Padding="18,14">
            <Grid>
                <StackPanel>
                    <TextBlock Text="StickyTodo" Style="{StaticResource Text.Title}" />
                    <TextBlock Text="{Binding BoardName}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#26B8860B" CornerRadius="9" Padding="9,4">
                    <TextBlock Text="{Binding EntitlementBadge}" FontSize="11"
                               Foreground="#FF8A6508" />
                </Border>
            </Grid>
        </Border>

        <!-- 输入区 -->
        <Grid Grid.Row="1" Margin="18,14,18,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="InputBox"
                     Grid.Column="0"
                     Style="{StaticResource TextBox.Flat}"
                     Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="输入后按回车添加">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                </TextBox.InputBindings>
            </TextBox>

            <Button Grid.Column="1" Margin="8,0,0,0"
                    Style="{StaticResource Button.Primary}"
                    Command="{Binding AddCommand}"
                    Content="添加" />
        </Grid>

        <!-- 列表 -->
        <Grid Grid.Row="2" Margin="0,4,0,0">
            <ListBox ItemsSource="{Binding Todos}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row"
                                            Padding="18,10"
                                            BorderBrush="{StaticResource Brush.Line}"
                                            BorderThickness="0,0,0,1"
                                            Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="#14B8860B" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0"
                                      IsChecked="{Binding IsDone, Mode=OneWay}"
                                      Command="{Binding DataContext.ToggleDoneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding}" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Title}"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Ink}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                <Setter Property="Foreground" Value="#FF9A9484" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Button Grid.Column="2"
                                    Content="✕"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Button.Link}"
                                    ToolTip="删除"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 空状态 -->
            <TextBlock Text="还没有待办，写下第一条吧"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource Brush.InkSoft}"
                       IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Todos.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="3" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,0" Padding="18,10">
            <Grid>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" />
                <TextBlock Text="{Binding ErrorText}"
                           HorizontalAlignment="Right"
                           FontSize="11"
                           Foreground="#FFC0392B"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>