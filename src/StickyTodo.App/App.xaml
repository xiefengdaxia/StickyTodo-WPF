<Application x:Class="StickyTodo.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- 便签风格配色：只放结构 token，主题化时替换这一层即可 -->
        <SolidColorBrush x:Key="Brush.Paper" Color="#FFFDF4D8" />
        <SolidColorBrush x:Key="Brush.PaperDeep" Color="#FFF7E9B8" />
        <SolidColorBrush x:Key="Brush.Ink" Color="#FF2B2B2B" />
        <SolidColorBrush x:Key="Brush.InkSoft" Color="#FF7A7468" />
        <SolidColorBrush x:Key="Brush.Accent" Color="#FFB8860B" />
        <SolidColorBrush x:Key="Brush.Line" Color="#22A08C50" />

        <Style x:Key="Text.Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Ink}" />
        </Style>

        <Style x:Key="Text.Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Brush.InkSoft}" />
        </Style>

        <Style x:Key="Button.Primary" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextBox.Flat" TargetType="TextBox">
            <Setter Property="Background" Value="#B3FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="Button.Link" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Brush.InkSoft}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFC0392B" />
                    <Setter Property="Background" Value="#14C0392B" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>