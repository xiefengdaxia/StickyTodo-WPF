<Window x:Class="StickyTodo.App.Views.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="贴图"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Border x:Name="Shell"
            BorderBrush="#66FFFFFF"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.28" Color="#FF000000" Direction="270" />
        </Border.Effect>

        <!-- Stretch=Uniform：窗口缩放时图片始终按原比例铺满，不变形 -->
        <Image x:Name="Picture" Stretch="Uniform" SnapsToDevicePixels="True" />
    </Border>
</Window>
