<Window x:Class="StickyTodo.App.Views.ReminderPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提醒"
        Icon="/Assets/stickytodo.ico"
        Width="300"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True">
    <Border Margin="10"
            CornerRadius="12"
            Background="{DynamicResource Brush.Paper}"
            BorderBrush="#59FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.35" Color="#FF000000" Direction="270" />
        </Border.Effect>

        <StackPanel Margin="14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⏰" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Text="待办提醒" Margin="6,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Ink}" />
                <TextBlock x:Name="TimeText" HorizontalAlignment="Right" Style="{StaticResource Text.Caption}"
                           VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>

            <TextBlock x:Name="TitleText"
                       Margin="0,10,0,0"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Ink}" />

            <TextBlock x:Name="BoardText" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="稍后 10 分钟" Style="{StaticResource Button.Ghost}" Click="Snooze_Click" />
                <Button Content="知道了" Style="{StaticResource Button.Primary}" Margin="8,0,0,0" Click="Ok_Click" />
            </StackPanel>        </StackPanel>
    </Border>
</Window>