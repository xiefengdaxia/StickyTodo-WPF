<Window x:Class="StickyTodo.App.Views.GifScreenPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GIF"
        Width="580"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True">
    <Window.Resources>
        <!-- 和录制悬浮条同一套深色风格：压在任意桌面上都看得清 -->
        <Style x:Key="PickerText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F0FFFFFF" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- 一块屏 = 一个按钮；本身按各屏相对位置摆好，也就是那张小示意图 -->
        <Style x:Key="ScreenButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F0FFFFFF" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="6" Background="#26FFFFFF"
                                BorderBrush="#55FFFFFF" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.35"
                                                  Color="#FF000000" Direction="270" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3FA9F5" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#FF3FA9F5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="8" CornerRadius="10"
            Background="#F2202124" BorderBrush="#40FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.4" Color="#FF000000" Direction="270" />
        </Border.Effect>

        <StackPanel Margin="14,12,14,10">
            <TextBlock x:Name="TitleText" Style="{StaticResource PickerText}"
                       FontSize="13" FontWeight="SemiBold" />

            <!-- 各屏按相对位置摆在这块画布上（尺寸由代码按屏幕数量算） -->
            <Canvas x:Name="Diagram" Width="536" Height="200" Margin="0,10,0,0"
                    ClipToBounds="False" />

            <TextBlock x:Name="HintText" Style="{StaticResource PickerText}"
                       Opacity="0.6" Margin="0,8,0,0" HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
