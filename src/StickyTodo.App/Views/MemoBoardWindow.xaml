<Window x:Class="StickyTodo.App.Views.MemoBoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding BoardName}"
        Width="380" Height="420"
        MinWidth="240" MinHeight="180"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Opacity="{Binding WindowOpacity, Mode=OneWay}"
        Topmost="{Binding IsTopmost, Mode=OneWay}"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Border x:Name="NoteRoot"
            Margin="10"
            CornerRadius="12"
            Background="{DynamicResource Brush.Paper}"
            BorderBrush="#59FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.30" Color="#FF000000" Direction="270" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.PaperDeep}"
                    CornerRadius="11,11,0,0"
                    Padding="12,8"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding BoardName}"
                                       Style="{StaticResource Text.Title}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text=" 🔒"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}"
                                   Style="{StaticResource Text.Caption}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Opacity" Value="0.35" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Button Style="{StaticResource Button.Chrome}" ToolTip="置顶" Click="ToggleTopmost_Click">
                            <TextBlock Text="📌" FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Opacity" Value="0.35" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTopmost}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>

                        <Button Style="{StaticResource Button.Chrome}" ToolTip="锁定（防误改）" Click="ToggleLock_Click">
                            <TextBlock FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="🔓" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                <Setter Property="Text" Value="🔒" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>

                        <Button Style="{StaticResource Button.Chrome}" Content="🎨" FontSize="11" ToolTip="皮肤与透明度" Click="Appearance_Click" />
                        <Button Style="{StaticResource Button.Chrome}" Content="⋯" FontSize="13" ToolTip="看板管理" Click="OpenManager_Click" />
                        <Button Style="{StaticResource Button.Chrome}" Content="✕" FontSize="11" ToolTip="关闭" Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 整块就是一张纸：无边框输入，边写边存 -->
            <TextBox x:Name="Editor"
                     Grid.Row="1"
                     Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     IsEnabled="{Binding IsLocked, Converter={StaticResource InverseBool}}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="14,12"
                     FontSize="13.5"
                     Foreground="{DynamicResource Brush.Ink}"
                     CaretBrush="{DynamicResource Brush.Ink}"
                     SpellCheck.IsEnabled="False"
                     TextChanged="Editor_TextChanged" />

            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="0,1,0,0"
                    Padding="12,6">
                <Grid>
                    <TextBlock Text="想写什么就写什么，自动保存"
                               Style="{StaticResource Text.Caption}"
                               Opacity="0.75"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ErrorText}"
                               HorizontalAlignment="Right"
                               FontSize="11"
                               Foreground="#FFC0392B"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>