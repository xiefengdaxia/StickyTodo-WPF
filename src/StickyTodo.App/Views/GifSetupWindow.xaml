<Window x:Class="StickyTodo.App.Views.GifSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GIF"
        Width="420"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="SetupText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F0FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SetupButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F0FFFFFF" />
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3FA9F5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SetupPrimary" TargetType="Button" BasedOn="{StaticResource SetupButton}">
            <Setter Property="Background" Value="#E6403A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SetupRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#F0FFFFFF" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,18,0" />
        </Style>

        <Style x:Key="SetupCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F0FFFFFF" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Border Margin="8" CornerRadius="10"
            Background="#F2202124" BorderBrush="#40FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.4" Color="#FF000000" Direction="270" />
        </Border.Effect>

        <StackPanel Margin="16,14,16,12">
            <TextBlock x:Name="TitleText" Style="{StaticResource SetupText}"
                       FontSize="13.5" FontWeight="SemiBold" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource SetupText}"
                       Opacity="0.6" Margin="0,4,0,12" TextWrapping="Wrap" />

            <!-- 范围 -->
            <TextBlock x:Name="ScopeLabel" Style="{StaticResource SetupText}" Opacity="0.75" />
            <StackPanel Orientation="Horizontal" Margin="0,7,0,10">
                <RadioButton x:Name="RegionRadio" GroupName="GifScope" Style="{StaticResource SetupRadio}"
                             Checked="Scope_Changed" />
                <RadioButton x:Name="FullScreenRadio" GroupName="GifScope" Style="{StaticResource SetupRadio}"
                             Checked="Scope_Changed" />
            </StackPanel>

            <!-- 区域尺寸 + 重新框选 -->
            <Border x:Name="RegionRow" Background="#14FFFFFF" CornerRadius="6"
                    Padding="10,8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="SizeLabel" Style="{StaticResource SetupText}" Opacity="0.7" />
                    <TextBlock Grid.Column="1" x:Name="SizeValue" Style="{StaticResource SetupText}"
                               FontFamily="Consolas" Margin="8,0,0,0" />
                    <Button Grid.Column="2" x:Name="ReselectButton" Style="{StaticResource SetupButton}"
                            Padding="10,4" Click="Reselect_Click" />
                </Grid>
            </Border>

            <!-- 倒计时 -->
            <CheckBox x:Name="CountdownBox" Style="{StaticResource SetupCheck}" Margin="0,2,0,12" />

            <!-- 清晰度 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="QualityLabel" Style="{StaticResource SetupText}" Opacity="0.75" />
                <ComboBox Grid.Column="1" x:Name="QualityBox" Height="26" Margin="10,0,0,0"
                          FontSize="12" VerticalContentAlignment="Center" />
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Style="{StaticResource SetupButton}" Click="Cancel_Click" />
                <Button x:Name="StartButton" Style="{StaticResource SetupPrimary}" Click="Start_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
