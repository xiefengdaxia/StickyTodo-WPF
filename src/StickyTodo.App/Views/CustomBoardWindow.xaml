<Window x:Class="StickyTodo.App.Views.CustomBoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{Binding BoardName}"
        Opacity="{Binding WindowOpacity, Mode=OneWay}"
        Icon="/Assets/stickytodo.ico"
        Width="620" Height="520"
        MinWidth="340" MinHeight="240"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="{Binding IsTopmost, Mode=OneWay}"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- 隐形缩放热区：模板里只放一个透明 Border，保证不画出任何边线/底色 -->
        <Style x:Key="ResizeHit" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="NoteRoot"
            Margin="10"
            CornerRadius="12"
            Background="{Binding PaperBrush}"
            BorderBrush="#59FFFFFF"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Background="{Binding PaperDeepBrush}"
                    CornerRadius="11,11,0,0"
                    Padding="12,8"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✨" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BoardName}" Style="{StaticResource Text.Title}"
                                   Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PinButton" Style="{StaticResource Button.Chrome}" Click="ToggleTopmost_Click"
                                ToolTip="置顶（其它窗口不会盖住它）">
                            <TextBlock Text="📌" FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Opacity" Value="0.45" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTopmost}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button x:Name="LockButton" Style="{StaticResource Button.Chrome}" Click="ToggleLock_Click"
                                ToolTip="锁定穿透（锁定后点不到，用右上角小锁或 Ctrl+Alt+L 解锁）">
                            <TextBlock FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="🔓" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                <Setter Property="Text" Value="🔒" />
                                                <Setter Property="Opacity" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Style="{StaticResource Button.Chrome}" Content="🎨" FontSize="11"
                                Click="Appearance_Click" ToolTip="外观：皮肤 / 透明度" />
                        <Button Style="{StaticResource Button.Chrome}" Content="☰" FontSize="11"
                                Click="OpenManager_Click" ToolTip="看板管理" />
                        <Button x:Name="RefreshButton" Style="{StaticResource Button.Chrome}" Content="↻" FontSize="12"
                                Click="Refresh_Click" ToolTip="立刻重跑一次采集器" />
                        <Button Style="{StaticResource Button.Chrome}" Content="✕" FontSize="11"
                                Click="Close_Click" ToolTip="关闭" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 内容：WebView2 优先，起不来时文本兜底 -->
            <Grid Grid.Row="1">
                <wv2:WebView2 x:Name="Web"
                              DefaultBackgroundColor="Transparent"
                              Visibility="{Binding WebViewFailed, Converter={StaticResource InverseBoolToVis}}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding WebViewFailed, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding FallbackText}"
                               Margin="14,10" TextWrapping="Wrap"
                               FontFamily="Consolas" FontSize="12" />
                </ScrollViewer>
            </Grid>

            <!-- 状态条 -->
            <Border Grid.Row="2"
                    Background="{Binding PaperDeepBrush}"
                    CornerRadius="0,0,11,11"
                    Padding="12,4">
                <TextBlock Text="{Binding StatusText}"
                           FontSize="11" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Brush.InkSoft}" />
            </Border></Grid>
    </Border>
</Window>