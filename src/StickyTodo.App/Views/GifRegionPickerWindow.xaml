<Window x:Class="StickyTodo.App.Views.GifRegionPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GIF"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        Cursor="Cross">

    <Window.Resources>
        <Style x:Key="PickerButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F0FFFFFF" />
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3FA9F5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PickerPrimary" TargetType="Button" BasedOn="{StaticResource PickerButton}">
            <Setter Property="Background" Value="#E6403A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Canvas x:Name="Root" Background="#66000000">

        <!-- 选区（物理像素换回来的 DIP 矩形） -->
        <Border x:Name="Selection" Visibility="Collapsed"
                BorderBrush="#FFF03A3A" BorderThickness="2"
                Background="#22F03A3A" IsHitTestVisible="False" />

        <!-- 选区尺寸标签 -->
        <Border x:Name="SizeChip" Visibility="Collapsed" IsHitTestVisible="False"
                Background="#E6202124" CornerRadius="4" Padding="7,3"
                BorderBrush="#40FFFFFF" BorderThickness="1">
            <TextBlock x:Name="SizeText" Foreground="#FFF0F0F0" FontSize="12"
                       FontFamily="Consolas" />
        </Border>

        <!-- 顶部提示 -->
        <TextBlock x:Name="TopHint" Foreground="#F0FFFFFF" FontSize="13"
                   HorizontalAlignment="Center" IsHitTestVisible="False">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.8" Color="#FF000000" />
            </TextBlock.Effect>
        </TextBlock>

        <!-- 底部工具条 -->
        <Border x:Name="Toolbar" Visibility="Collapsed"
                Background="#F2202124" CornerRadius="9" Padding="12,8"
                BorderBrush="#40FFFFFF" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.4" Color="#FF000000" Direction="270" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="ScopeHint" Foreground="#D0FFFFFF" FontSize="12"
                           VerticalAlignment="Center" Margin="2,0,10,0" />
                <Button x:Name="FullScreenButton" Style="{StaticResource PickerButton}" Click="FullScreen_Click" />
                <Button x:Name="CancelButton" Style="{StaticResource PickerButton}" Click="Cancel_Click" />
                <Button x:Name="StartButton" Style="{StaticResource PickerPrimary}" Click="Start_Click" />
            </StackPanel>
        </Border>
    </Canvas>
</Window>
