<Window x:Class="StickyTodo.App.Views.PerformanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="性能看板"
        Icon="/Assets/stickytodo.ico"
        Width="440" Height="475"
        MinWidth="380" MinHeight="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True">

    <Border x:Name="NoteRoot"
            Margin="10"
            CornerRadius="12"
            Background="{DynamicResource Brush.Paper}"
            BorderBrush="#59FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.30" Color="#FF000000" Direction="270" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.PaperDeep}"
                    CornerRadius="11,11,0,0"
                    Padding="12,8"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 标题图标加 AccentSoft 底，与整块设计呼应 -->
                        <Border Padding="6,4" CornerRadius="7" Background="{DynamicResource Brush.AccentSoft}">
                            <TextBlock Text="🖥️" FontSize="11" />
                        </Border>
                        <TextBlock Text="性能看板" Style="{StaticResource Text.Title}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding UptimeText}" FontSize="10.5" Opacity="0.7"
                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                   Foreground="{DynamicResource Brush.InkSoft}" />
                        <Button Style="{StaticResource Button.Chrome}" Content="🎨" FontSize="11"
                                ToolTip="皮肤与透明度" Click="Appearance_Click" />
                        <Button Style="{StaticResource Button.Chrome}" Content="✕" FontSize="11"
                                ToolTip="关闭" Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,6,8,10">
                <StackPanel>

                    <!-- ============ CPU：折线 + 大数字 ============ -->
                    <Border Style="{StaticResource MetricCard}" Margin="2,4" Padding="0" CornerRadius="10"
                            Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                            BorderThickness="1">
                        <Grid>
                            <!-- 左侧强调色竖条：一眼区分指标分区 -->
                            <Border Width="3" HorizontalAlignment="Left" CornerRadius="10,0,0,10"
                                    Background="{DynamicResource Brush.Accent}" />
                            <StackPanel Margin="14,9,12,9">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="CPU" FontSize="11.5" FontWeight="SemiBold" Opacity="0.8"
                                                   Foreground="{DynamicResource Brush.InkSoft}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding CpuCoresText}" FontSize="10" Opacity="0.55"
                                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.InkSoft}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding CpuText}" FontSize="24" FontWeight="Light"
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource Brush.Ink}" />
                                </Grid>
                                <Border Height="58" Margin="0,8,0,0" CornerRadius="8" Background="#12000000">
                                    <Canvas x:Name="CpuChart" Margin="6,4" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ============ 内存：进度条 ============ -->
                    <Border Style="{StaticResource MetricCard}" Margin="2,4" Padding="0" CornerRadius="10"
                            Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                            BorderThickness="1">
                        <Grid>
                            <Border Width="3" HorizontalAlignment="Left" CornerRadius="10,0,0,10"
                                    Background="{DynamicResource Brush.Accent}" />
                            <StackPanel Margin="14,9,12,9">
                                <Grid>
                                    <TextBlock Text="内存" FontSize="11.5" FontWeight="SemiBold" Opacity="0.8"
                                               Foreground="{DynamicResource Brush.InkSoft}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding MemoryText}" FontSize="13"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Ink}" />
                                </Grid>
                                <Grid Height="10" Margin="0,9,0,0">
                                    <Border CornerRadius="5" Background="{DynamicResource Brush.Track}" />
                                    <Border x:Name="MemoryBar" CornerRadius="5" HorizontalAlignment="Left"
                                            Background="{DynamicResource Brush.Accent}" />
                                </Grid>
                                <Grid Margin="0,5,0,0">
                                    <TextBlock Text="{Binding MemoryValue, StringFormat={}{0:0.0}% 使用}" FontSize="10.5"
                                               Opacity="0.65" Foreground="{DynamicResource Brush.InkSoft}" />
                                    <TextBlock Text="{Binding MemoryFreeText}" FontSize="10.5" Opacity="0.65"
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource Brush.InkSoft}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ============ 磁盘 + GPU：两列并排，省一行 ============ -->
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Margin="2,4" Padding="0" CornerRadius="10"
                                Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                                BorderThickness="1">
                            <Grid>
                                <Border Width="3" HorizontalAlignment="Left" CornerRadius="10,0,0,10"
                                        Background="{DynamicResource Brush.Accent}" />
                                <StackPanel Margin="14,9,12,9">
                                    <Grid>
                                        <TextBlock Text="磁盘" FontSize="11.5" FontWeight="SemiBold" Opacity="0.8"
                                                   Foreground="{DynamicResource Brush.InkSoft}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DiskActiveText}" FontSize="20" FontWeight="Light"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource Brush.Ink}" />
                                    </Grid>
                                    <Grid Height="8" Margin="0,8,0,0">
                                        <Border CornerRadius="4" Background="{DynamicResource Brush.Track}" />
                                        <Border x:Name="DiskBar" CornerRadius="4" HorizontalAlignment="Left"
                                                Background="{DynamicResource Brush.Accent}" />
                                    </Grid>
                                    <TextBlock Text="{Binding DiskIoText}" FontSize="10.5" Margin="0,7,0,0"
                                               Foreground="{DynamicResource Brush.InkSoft}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Margin="2,4" Padding="0" CornerRadius="10"
                                Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                                BorderThickness="1"
                                Visibility="{Binding HasGpu, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Border Width="3" HorizontalAlignment="Left" CornerRadius="10,0,0,10"
                                        Background="{DynamicResource Brush.Accent}" />
                                <StackPanel Margin="14,9,12,9">
                                    <Grid>
                                        <TextBlock Text="GPU" FontSize="11.5" FontWeight="SemiBold" Opacity="0.8"
                                                   Foreground="{DynamicResource Brush.InkSoft}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding GpuText}" FontSize="20" FontWeight="Light"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource Brush.Ink}" />
                                    </Grid>
                                    <Grid Height="8" Margin="0,8,0,0">
                                        <Border CornerRadius="4" Background="{DynamicResource Brush.Track}" />
                                        <Border x:Name="GpuBar" CornerRadius="4" HorizontalAlignment="Left"
                                                Background="{DynamicResource Brush.Accent}" />
                                    </Grid>
                                    <TextBlock Text="{Binding GpuEngineName}" FontSize="10.5" Margin="0,7,0,0"
                                               Opacity="0.65" Foreground="{DynamicResource Brush.InkSoft}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ============ 网络：与网速看板同源 ============ -->
                    <Border Margin="2,4" Padding="0" CornerRadius="10"
                            Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                            BorderThickness="1">
                        <Grid>
                            <Border Width="3" HorizontalAlignment="Left" CornerRadius="10,0,0,10"
                                    Background="{DynamicResource Brush.Accent}" />
                            <StackPanel Margin="14,9,12,9">
                                <Grid>
                                    <TextBlock Text="网络" FontSize="11.5" FontWeight="SemiBold" Opacity="0.8"
                                               Foreground="{DynamicResource Brush.InkSoft}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="↓" FontSize="13" Foreground="#FF2E7D32" Margin="0,0,3,0" />
                                        <TextBlock Text="{Binding NetworkDownloadText}" FontSize="13"
                                                   Foreground="{DynamicResource Brush.Ink}" Margin="0,0,10,0" />
                                        <TextBlock Text="↑" FontSize="13" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,3,0" />
                                        <TextBlock Text="{Binding NetworkUploadText}" FontSize="13"
                                                   Foreground="{DynamicResource Brush.Ink}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
