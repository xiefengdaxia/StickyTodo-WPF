<Window x:Class="StickyTodo.App.Views.TokenBoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StickyTodo.App.Controls"
        Title="{Binding BoardName}"
        Icon="/Assets/stickytodo.ico"
        Width="430" Height="600"
        MinWidth="320" MinHeight="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Opacity="{Binding WindowOpacity, Mode=OneWay}"
        Topmost="{Binding IsTopmost, Mode=OneWay}"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="RangeTab" TargetType="Button" BasedOn="{StaticResource SegmentTab}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Opacity" Value="0.7" />
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
        </Style>
    </Window.Resources>

    <Border x:Name="NoteRoot"
            Margin="10"
            CornerRadius="12"
            Background="{DynamicResource Brush.Paper}"
            BorderBrush="#59FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.30" Color="#FF000000" Direction="270" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============ 标题栏 ============ -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.PaperDeep}"
                    CornerRadius="11,11,0,0"
                    Padding="12,8"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding BoardName}"
                                       Style="{StaticResource Text.Title}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text=" 🔒"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding RangeText}"
                                   Style="{StaticResource Text.Caption}"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource Button.Chrome}" ToolTip="{Binding Converter={StaticResource Loc}, ConverterParameter=chrome.topmost}" Click="ToggleTopmost_Click">
                            <TextBlock Text="📌" FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Opacity" Value="0.35" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTopmost}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Style="{StaticResource Button.Chrome}" ToolTip="{Binding Converter={StaticResource Loc}, ConverterParameter=chrome.lockTip}" Click="ToggleLock_Click">
                            <TextBlock FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="🔓" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                <Setter Property="Text" Value="🔒" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Style="{StaticResource Button.Chrome}" Content="🎨" FontSize="11" ToolTip="{Binding Converter={StaticResource Loc}, ConverterParameter=chrome.appearance}" Click="Appearance_Click" />
                        <Button Style="{StaticResource Button.Chrome}" Content="⋯" FontSize="13" ToolTip="{Binding Converter={StaticResource Loc}, ConverterParameter=chrome.manage}" Click="OpenManager_Click" />
                        <Button Style="{StaticResource Button.Chrome}" Content="✕" FontSize="11" ToolTip="{Binding Converter={StaticResource Loc}, ConverterParameter=chrome.close}" Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ 工具行：范围 / 刷新间隔 / 手动刷新 ============ -->
            <Grid Grid.Row="1" Margin="12,8,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ItemsControl Grid.Column="0" ItemsSource="{Binding Ranges}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RangeTab}"
                                    Content="{Binding Name}"
                                    Margin="0,0,2,0"
                                    Command="{Binding DataContext.PickRangeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl Grid.Column="2" ItemsSource="{Binding Intervals}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RangeTab}"
                                    Content="{Binding Name}"
                                    Margin="2,0,0,0"
                                    Padding="7,3"
                                    Command="{Binding DataContext.PickIntervalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- ============ 汇总 ============ -->
            <Border Grid.Row="2"
                    Margin="12,10,12,0"
                    Padding="12,10"
                    CornerRadius="10"
                    Background="{DynamicResource Brush.Surface}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=token.total}" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding TotalText}" Style="{StaticResource MetricValue}" FontSize="22" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=token.calls}" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding StepsText}" Style="{StaticResource MetricValue}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=token.cacheRatio}" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding CacheRatioText}" Style="{StaticResource MetricValue}" />
                    </StackPanel>

                    <Button Grid.Column="3"
                            x:Name="RefreshButton"
                            Style="{StaticResource Button.Chrome}"
                            ToolTip="{Binding RefreshHint}"
                            Click="Refresh_Click"
                            VerticalAlignment="Center"
                            Margin="6,0,0,0">
                        <!-- 取数时持续旋转，是最直观的"正在刷新"；空闲时轻轻回正 -->
                        <TextBlock x:Name="RefreshGlyph" Text="⟳" FontSize="15"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="0" />
                            </TextBlock.RenderTransform>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Opacity" Value="1" />
                                    <Style.Triggers>
                                        <!-- 只有首次取数（还没有任何数据）才变暗，切范围时不闪 -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsBusy}" Value="True" />
                                                <Condition Binding="{Binding HasData}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Opacity" Value="0.35" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <Button Grid.Column="4"
                            Style="{StaticResource Button.Chrome}"
                            ToolTip="{Binding Converter={StaticResource Loc}, ConverterParameter=token.copyTip}"
                            Click="Copy_Click"
                            VerticalAlignment="Center"
                            Margin="2,0,0,0">
                        <TextBlock Text="⧉" FontSize="14" />
                    </Button>

                    <!-- 复制结果提示：3 秒后自动消失 -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5"
                               Text="{Binding CopyStatusText}"
                               Style="{StaticResource Text.Caption}"
                               HorizontalAlignment="Right"
                               Margin="0,6,0,0"
                               Foreground="#FF2E7D32"
                               Visibility="{Binding CopyStatusText, Converter={StaticResource NullToCollapsed}}" />
                </Grid>
            </Border>

            <TextBlock Grid.Row="3"
                       Margin="14,6,14,0"
                       Text="{Binding BreakdownText}"
                       Style="{StaticResource Text.Caption}"
                       TextWrapping="Wrap"
                       Opacity="0.85" />

            <!-- ============ 趋势 ============ -->
            <StackPanel Grid.Row="4" Margin="12,6,12,0">
                <Grid Margin="2,0,2,4">
                    <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=token.trendTitle}"
                               Style="{StaticResource Text.Caption}"
                               Opacity="0.75" />
                    <Button HorizontalAlignment="Right"
                            Style="{StaticResource Button.Link}"
                            Content="{Binding Converter={StaticResource Loc}, ConverterParameter=token.hideDetail}"
                            FontSize="10"
                            Padding="0"
                            Click="HideDetail_Click"
                            Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <controls:TrendChart x:Name="Chart"
                                     Height="132"
                                     Series="{Binding Stats.Series}"
                                     SelectedIndex="{Binding SelectedIndex, Mode=OneWay}"
                                     Accent="{DynamicResource Brush.Accent}" />

                <!-- 点击后的明细 -->
                <Border Margin="0,6,0,0"
                        Padding="10,7"
                        CornerRadius="8"
                        Background="{DynamicResource Brush.AccentSoft}"
                        Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding DetailTitle}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Ink}" />
                        <TextBlock Text="{Binding DetailBody}"
                                   Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============ 按模型 ============ -->
            <Grid Grid.Row="5" Margin="12,10,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding Converter={StaticResource Loc}, ConverterParameter=token.byModel}"
                           Style="{StaticResource Text.Caption}"
                           Opacity="0.75"
                           Margin="2,0,0,4" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Models}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Brush.Ink}" />
                                        <TextBlock Text="{Binding DetailText}"
                                                   Style="{StaticResource Text.Caption}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Opacity="0.7" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding TotalText}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource Brush.Ink}" />
                                        <TextBlock Text="{Binding ShareText}"
                                                   Style="{StaticResource Text.Caption}"
                                                   HorizontalAlignment="Right"
                                                   Opacity="0.7" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ============ 页脚 ============ -->
            <Border Grid.Row="6"
                    BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="0,1,0,0"
                    Padding="12,6"
                    Margin="0,8,0,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding UpdatedText}"
                                   Style="{StaticResource Text.Caption}"
                                   Opacity="0.75" />
                        <TextBlock Text="{Binding SourceText}"
                                   Style="{StaticResource Text.Caption}"
                                   Opacity="0.5"
                                   FontSize="9.5"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="300"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ErrorText}"
                                   HorizontalAlignment="Right"
                                   FontSize="11"
                                   Foreground="#FFC0392B"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="220" />
                        <TextBlock Text="{Binding SourceError}"
                                   HorizontalAlignment="Right"
                                   FontSize="10"
                                   Foreground="#FFC0392B"
                                   TextWrapping="Wrap"
                                   MaxWidth="220"
                                   Visibility="{Binding SourceError, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>