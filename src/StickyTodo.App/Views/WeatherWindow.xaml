<Window x:Class="StickyTodo.App.Views.WeatherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding BoardName}"
        Icon="/Assets/stickytodo.ico"
        Width="880" Height="700"
        MinWidth="640" MinHeight="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Border x:Name="NoteRoot"
            Margin="10"
            CornerRadius="12"
            Background="{DynamicResource Brush.Paper}"
            BorderBrush="#59FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.30" Color="#FF000000" Direction="270" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.PaperDeep}"
                    CornerRadius="11,11,0,0"
                    Padding="12,8"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🌤" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="天气" Style="{StaticResource Text.Title}"
                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource Button.Chrome}" Content="🎨" FontSize="11"
                                ToolTip="皮肤与透明度" Click="Appearance_Click" />
                        <Button Style="{StaticResource Button.Chrome}" Content="✕" FontSize="11"
                                ToolTip="关闭" Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 内容 -->
            <Grid Grid.Row="1" Margin="18,12,18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 城市选择 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="所有城市"
                               Style="{StaticResource Text.Section}"
                               VerticalAlignment="Top" Margin="0,8,10,0" />
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Cities}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,8,8"
                                        Padding="18,5"
                                        Click="City_Click"
                                        Tag="{Binding}"
                                        Content="{Binding DisplayName}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="#66FFFFFF" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Root" CornerRadius="4" Background="{TemplateBinding Background}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                              Margin="{TemplateBinding Padding}" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#FF2C3E50" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 城市管理入口：默认收起，点它才展开下面那一行 -->
                    <Button Grid.Column="2" x:Name="CityEditorToggle"
                            Style="{StaticResource Button.Ghost}"
                            Content="{Binding CityEditorToggleText}"
                            FontSize="12" Padding="10,5" Margin="0,0,0,8"
                            VerticalAlignment="Top"
                            ToolTip="添加 / 删除城市、设置默认城市"
                            Click="ToggleCityEditor_Click" />
                </Grid>

                <!-- 城市行：输入（模糊搜索 + 下拉建议） + 操作按钮（点上面的按钮才展开） -->
                <Grid Grid.Row="1" Margin="58,0,2,8"
                      Visibility="{Binding IsCityEditorOpen, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="190">
                        <TextBox x:Name="NewCityBox"
                                 Style="{StaticResource TextBox.Flat}"
                                 FontSize="12" Padding="10,5"
                                 TextChanged="NewCity_TextChanged"
                                 PreviewKeyDown="NewCity_PreviewKeyDown" />
                        <TextBlock Text="城市名，如 长沙 / 浏阳" FontSize="12" IsHitTestVisible="False"
                                   Foreground="{DynamicResource Brush.InkSoft}"
                                   VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=NewCityBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- 模糊搜索下拉：输一个字就按省市区县表给候选 -->
                        <Popup x:Name="CityPopup"
                               PlacementTarget="{Binding ElementName=NewCityBox}"
                               Placement="Bottom" VerticalOffset="4"
                               StaysOpen="False" AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Width="250" MaxHeight="250" Margin="0,0,10,10"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                                    CornerRadius="8" Padding="4">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.28"
                                                      Color="#FF000000" Direction="270" />
                                </Border.Effect>
                                <ListBox x:Name="CitySuggestionList" MaxHeight="240"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         MouseLeftButtonUp="CitySuggestion_Click">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="8,5" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Bd" CornerRadius="5" Background="Transparent"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#14000000" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Bd" Property="Background"
                                                                        Value="{DynamicResource Brush.AccentSoft}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" FontSize="12"
                                                       Foreground="{DynamicResource Brush.Ink}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>

                    <Button Grid.Column="1" Content="添加" Margin="8,0,0,0" Padding="14,5" FontSize="12"
                            VerticalAlignment="Center" Style="{StaticResource Button.Primary}"
                            Click="AddCity_Click" />
                    <Button Grid.Column="2" Content="设为默认" Margin="6,0,0,0" Padding="14,5" FontSize="12"
                            VerticalAlignment="Center" Style="{StaticResource Button.Ghost}"
                            Click="SetDefaultCity_Click"
                            ToolTip="桌面时钟优先显示这个城市" />
                    <Button Grid.Column="3" Content="移除当前" Margin="6,0,0,0" Padding="14,5" FontSize="12"
                            VerticalAlignment="Center" Style="{StaticResource Button.Ghost}"
                            IsEnabled="{Binding CanRemoveCity}"
                            Click="RemoveCity_Click" />
                    <TextBlock Grid.Column="4" Text="{Binding NoticeText}" Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                </Grid>

                <Grid Grid.Row="2" Margin="2,0,2,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <TextBlock Text="📍" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentCity}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Ink}" Margin="6,0,0,0" />
                        <TextBlock Text="{Binding CurrentCityNote}" Style="{StaticResource Text.Caption}" Margin="4,0,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource Button.Chrome}" Content="⟳" FontSize="13"
                                VerticalAlignment="Center" Margin="6,0,0,0" Click="Refresh_Click" />
                    </StackPanel>
                </Grid>

                <!-- 实时天气 -->
                <StackPanel Grid.Row="3" Margin="2,0,2,16">
                    <TextBlock Text="实时天气" Style="{StaticResource Text.Section}" Margin="0,0,0,10" />
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding CurrentIconGlyph}" FontSize="46"
                                   VerticalAlignment="Center" Margin="0,0,14,0"
                                   Foreground="#FFFFB300" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentTempText}" FontSize="40" FontWeight="Light"
                                       Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentText}" FontSize="14"
                                       Foreground="{DynamicResource Brush.InkSoft}"
                                       VerticalAlignment="Bottom" Margin="10,0,0,10" />
                        </StackPanel>

                        <UniformGrid Grid.Column="2" Columns="4" VerticalAlignment="Center">
                            <Border Margin="4,0" Padding="14,10" CornerRadius="4" Background="#11FFFFFF">
                                <StackPanel>
                                    <TextBlock Text="空气质量" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding AirQualityText}" FontSize="15" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Ink}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Margin="4,0" Padding="14,10" CornerRadius="4" Background="#11FFFFFF">
                                <StackPanel>
                                    <TextBlock Text="空气指数" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding AirQualityIndexText}" FontSize="15" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Ink}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Margin="4,0" Padding="14,10" CornerRadius="4" Background="#11FFFFFF">
                                <StackPanel>
                                    <TextBlock Text="风力" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding CurrentWind}" FontSize="15" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Ink}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Margin="4,0" Padding="14,10" CornerRadius="4" Background="#11FFFFFF">
                                <StackPanel>
                                    <TextBlock Text="湿度" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding HumidityText}" FontSize="15" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Ink}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </StackPanel>

                <!-- 预报 -->
                <StackPanel Grid.Row="4">
                    <TextBlock Text="天气预报" Style="{StaticResource Text.Section}" Margin="0,0,0,10" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Days}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,0" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding DayLabel}" FontSize="14" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.Ink}" />
                                        <TextBlock Text="{Binding DateLabel}" Style="{StaticResource Text.Caption}"
                                                   HorizontalAlignment="Center" Margin="0,2,0,8" />
                                        <TextBlock Text="{Binding IconGlyph}" FontSize="26" HorizontalAlignment="Center"
                                                   Foreground="#FFFFB300" />
                                        <TextBlock Text="{Binding Text}" FontSize="12" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.Ink}" Margin="0,6,0,0" />

                                        <!-- 高低温折线用文本代替：上高下低 -->
                                        <TextBlock Text="{Binding TempMaxText}" FontSize="13" HorizontalAlignment="Center"
                                                   Foreground="#FFE67E22" Margin="0,14,0,0" />
                                        <TextBlock Text="{Binding TempMinText}" FontSize="13" HorizontalAlignment="Center"
                                                   Foreground="#FF3498DB" Margin="0,18,0,0" />

                                        <TextBlock Text="{Binding IconGlyph2}" FontSize="26" HorizontalAlignment="Center"
                                                   Foreground="#FFFFB300" Margin="0,14,0,0" />
                                        <TextBlock Text="{Binding Text}" FontSize="12" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.Ink}" Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding Wind}" Style="{StaticResource Text.Caption}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- 加载中 / 获取失败：只盖天气内容区（第 3~4 行），城市栏仍可点击切换 -->
                <Border Grid.Row="3" Grid.RowSpan="2" Background="{DynamicResource Brush.PaperOpaque}"
                        Visibility="{Binding IsBusyOverlayVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding BusyText}" FontSize="15" MaxWidth="520"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource Brush.InkSoft}" HorizontalAlignment="Center" />
                        <Button Content="重试" Style="{StaticResource Button.Primary}" Margin="0,14,0,0"
                                HorizontalAlignment="Center" Click="Refresh_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
