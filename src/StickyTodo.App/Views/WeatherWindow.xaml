<Window x:Class="StickyTodo.App.Views.WeatherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding BoardName}"
        Icon="/Assets/stickytodo.ico"
        Width="880" Height="960"
        MinWidth="720" MinHeight="760"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Border x:Name="NoteRoot"
            Margin="10"
            CornerRadius="12"
            Background="{DynamicResource Brush.Paper}"
            BorderBrush="#59FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.30" Color="#FF000000" Direction="270" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.PaperDeep}"
                    CornerRadius="11,11,0,0"
                    Padding="12,8"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🌤" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="天气" Style="{StaticResource Text.Title}"
                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource Button.Chrome}" Content="🎨" FontSize="11"
                                ToolTip="皮肤与透明度" Click="Appearance_Click" />
                        <Button Style="{StaticResource Button.Chrome}" Content="✕" FontSize="11"
                                ToolTip="关闭" Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 内容 -->
            <Grid Grid.Row="1" Margin="18,12,18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 城市选择 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="所有城市"
                               Style="{StaticResource Text.Section}"
                               VerticalAlignment="Top" Margin="0,8,10,0" />
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Cities}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,8,8"
                                        Padding="18,5"
                                        Click="City_Click"
                                        Tag="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="#66FFFFFF" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Root" CornerRadius="4" Background="{TemplateBinding Background}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                              Margin="{TemplateBinding Padding}" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#FF2C3E50" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- 城市行：位置 + 更新时间 -->
                <Grid Grid.Row="1" Margin="2,4,2,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <TextBlock Text="📍" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentCity}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Ink}" Margin="6,0,0,0" />
                        <TextBlock Text="（默认城市）" Style="{StaticResource Text.Caption}" Margin="4,0,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource Button.Chrome}" Content="⟳" FontSize="13"
                                VerticalAlignment="Center" Margin="6,0,0,0" Click="Refresh_Click" />
                    </StackPanel>
                </Grid>

                <!-- 实时天气 -->
                <StackPanel Grid.Row="2" Margin="2,0,2,16">
                    <TextBlock Text="实时天气" Style="{StaticResource Text.Section}" Margin="0,0,0,10" />
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding CurrentIconGlyph}" FontSize="46"
                                   VerticalAlignment="Center" Margin="0,0,14,0"
                                   Foreground="#FFFFB300" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentTempText}" FontSize="40" FontWeight="Light"
                                       Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentText}" FontSize="14"
                                       Foreground="{DynamicResource Brush.InkSoft}"
                                       VerticalAlignment="Bottom" Margin="10,0,0,10" />
                        </StackPanel>

                        <UniformGrid Grid.Column="2" Columns="4" VerticalAlignment="Center">
                            <Border Margin="4,0" Padding="14,10" CornerRadius="4" Background="#11FFFFFF">
                                <StackPanel>
                                    <TextBlock Text="空气质量" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding AirQualityText}" FontSize="15" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Ink}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Margin="4,0" Padding="14,10" CornerRadius="4" Background="#11FFFFFF">
                                <StackPanel>
                                    <TextBlock Text="空气指数" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding AirQualityIndexText}" FontSize="15" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Ink}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Margin="4,0" Padding="14,10" CornerRadius="4" Background="#11FFFFFF">
                                <StackPanel>
                                    <TextBlock Text="风力" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding CurrentWind}" FontSize="15" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Ink}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Margin="4,0" Padding="14,10" CornerRadius="4" Background="#11FFFFFF">
                                <StackPanel>
                                    <TextBlock Text="湿度" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding HumidityText}" FontSize="15" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Ink}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </StackPanel>

                <!-- 预报 -->
                <StackPanel Grid.Row="3">
                    <TextBlock Text="天气预报" Style="{StaticResource Text.Section}" Margin="0,0,0,10" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Days}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,0" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding DayLabel}" FontSize="14" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.Ink}" />
                                        <TextBlock Text="{Binding DateLabel}" Style="{StaticResource Text.Caption}"
                                                   HorizontalAlignment="Center" Margin="0,2,0,8" />
                                        <TextBlock Text="{Binding IconGlyph}" FontSize="26" HorizontalAlignment="Center"
                                                   Foreground="#FFFFB300" />
                                        <TextBlock Text="{Binding Text}" FontSize="12" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.Ink}" Margin="0,6,0,0" />

                                        <!-- 高低温折线用文本代替：上高下低 -->
                                        <TextBlock Text="{Binding TempMaxText}" FontSize="13" HorizontalAlignment="Center"
                                                   Foreground="#FFE67E22" Margin="0,14,0,0" />
                                        <TextBlock Text="{Binding TempMinText}" FontSize="13" HorizontalAlignment="Center"
                                                   Foreground="#FF3498DB" Margin="0,18,0,0" />

                                        <TextBlock Text="{Binding IconGlyph2}" FontSize="26" HorizontalAlignment="Center"
                                                   Foreground="#FFFFB300" Margin="0,14,0,0" />
                                        <TextBlock Text="{Binding Text}" FontSize="12" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.Ink}" Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding Wind}" Style="{StaticResource Text.Caption}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Grid>

            <!-- 加载中 / 失败提示 -->
            <Border Grid.Row="1" Background="{DynamicResource Brush.Paper}"
                    Visibility="{Binding IsBusyOverlayVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding BusyText}" FontSize="16"
                               Foreground="{DynamicResource Brush.InkSoft}" HorizontalAlignment="Center" />
                    <Button Content="重试" Style="{StaticResource Button.Primary}" Margin="0,16,0,0"
                            HorizontalAlignment="Center" Click="Refresh_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
