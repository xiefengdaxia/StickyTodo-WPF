<Window x:Class="StickyTodo.App.Views.MarketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Converter={StaticResource Loc}, ConverterParameter=market.title}"
        Width="980" Height="700"
        MinWidth="620" MinHeight="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Border Margin="10"
            CornerRadius="12"
            Background="{DynamicResource Brush.PaperOpaque}"
            BorderBrush="{DynamicResource Brush.Line}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.30" Color="#FF000000" Direction="270" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.PaperOpaque}"
                    BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="11,11,0,0"
                    Padding="14,9"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🧩" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=market.title}"
                                   Style="{StaticResource Text.Title}" Margin="7,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=market.subtitle}"
                                   FontSize="11" Foreground="{DynamicResource Brush.InkSoft}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource Button.Ghost}" Padding="10,4" Click="Refresh_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↻" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=market.refresh}"
                                           Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Content="✕" Style="{StaticResource Button.ChromeClose}" Margin="8,0,0,0" Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,14,8,4">
                <StackPanel>
                    <ItemsControl x:Name="Cards">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock x:Name="EmptyText"
                               Text="{Binding Converter={StaticResource Loc}, ConverterParameter=market.empty}"
                               Foreground="{DynamicResource Brush.InkSoft}" FontSize="12"
                               Margin="2,10,0,0" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="{DynamicResource Brush.PaperOpaque}"
                    BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,11,11"
                    Padding="14,6">
                <TextBlock x:Name="StatusText" FontSize="11" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Brush.InkSoft}" />
            </Border>
        </Grid>
    </Border>
</Window>
