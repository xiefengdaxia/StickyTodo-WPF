<Window x:Class="StickyTodo.App.Views.AiBoardGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Converter={StaticResource Loc}, ConverterParameter=manager.aiGuideTitle}"
        Icon="/Assets/stickytodo.ico"
        Width="470"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Border Margin="10"
            CornerRadius="12"
            Background="{DynamicResource Brush.PaperOpaque}"
            BorderBrush="{DynamicResource Brush.Line}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.30" Color="#FF000000" Direction="270" />
        </Border.Effect>

        <StackPanel Margin="18,15,18,15">

            <!-- 标题栏：拖动区 + 关闭 -->
            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🤖" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=manager.aiGuideTitle}"
                               Style="{StaticResource Text.Title}" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource Button.Chrome}"
                        Content="✕"
                        FontSize="10"
                        Click="Close_Click" />
            </Grid>

            <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=manager.aiGuideBody}"
                       Margin="0,10,0,0"
                       FontSize="12.5"
                       TextWrapping="Wrap"
                       LineHeight="19"
                       Foreground="{DynamicResource Brush.InkSoft}" />

            <!-- 三步：开 MCP → 把配置给 AI → 说一句想要什么 -->
            <Border Margin="0,12,0,0"
                    CornerRadius="9"
                    Padding="12,10"
                    Background="{DynamicResource Brush.ChipIdle}"
                    BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=manager.aiGuideStep1}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Ink}" />
                    <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=manager.aiGuideStep2}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,7,0,0"
                               Foreground="{DynamicResource Brush.Ink}" />
                    <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=manager.aiGuideStep3}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,7,0,0"
                               Foreground="{DynamicResource Brush.Ink}" />
                </StackPanel>
            </Border>

            <!-- 示例话术：等宽、可以直接选中抄，右边一键复制 -->
            <Border Margin="0,10,0,0"
                    CornerRadius="9"
                    Padding="10,8"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             x:Name="SampleBox"
                             Style="{StaticResource TextBox.Flat}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             FontFamily="Consolas, Microsoft YaHei UI"
                             FontSize="12"
                             TextWrapping="Wrap"
                             IsReadOnly="True"
                             VerticalContentAlignment="Top"
                             Text="{Binding Converter={StaticResource Loc}, ConverterParameter=manager.aiGuideSample, Mode=OneWay}" />

                    <Button Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Padding="10,4"
                            Style="{StaticResource Button.Ghost}"
                            Content="{Binding Converter={StaticResource Loc}, ConverterParameter=manager.aiGuideCopy}"
                            Click="Copy_Click" />
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource Button.Ghost}"
                        Content="{Binding Converter={StaticResource Loc}, ConverterParameter=manager.aiGuideMarket}"
                        Click="Market_Click" />
                <Button x:Name="OkButton"
                        Style="{StaticResource Button.Primary}"
                        Margin="8,0,0,0"
                        Content="{Binding Converter={StaticResource Loc}, ConverterParameter=manager.aiGuideClose}"
                        Click="Close_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
