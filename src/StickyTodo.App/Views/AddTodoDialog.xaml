<Window x:Class="StickyTodo.App.Views.AddTodoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Converter={StaticResource Loc}, ConverterParameter=cal.addTodoTitle}"
        Icon="/Assets/stickytodo.ico"
        Width="400"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True">
    <Border Margin="12"
            CornerRadius="12"
            Background="{DynamicResource Brush.Paper}"
            BorderBrush="#59FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.34" Color="#FF000000" Direction="270" />
        </Border.Effect>

        <StackPanel Margin="18,16,18,16">
            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="LabelText"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Ink}"
                           VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right"
                        Style="{StaticResource Button.Chrome}"
                        Content="✕"
                        FontSize="10"
                        Click="Cancel_Click" />
            </Grid>

            <TextBox x:Name="Input"
                     Style="{StaticResource TextBox.Flat}"
                     Margin="0,12,0,0" />

            <!-- 时间点：两个下拉框（时 / 分），留空 = 全天 -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="RemindCheck"
                          Grid.Column="0"
                          VerticalAlignment="Center"
                          Style="{StaticResource CheckBox.Labeled}"
                          Content="{Binding Converter={StaticResource Loc}, ConverterParameter=cal.addTimeLabel}"
                          Checked="RemindCheck_Changed"
                          Unchecked="RemindCheck_Changed" />
                <ComboBox x:Name="HourBox"
                          Grid.Column="1"
                          Width="64"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          Style="{StaticResource ComboBox.Flat}"
                          SelectionChanged="Time_Changed" />
                <TextBlock Grid.Column="2" Text=":" FontSize="14" Margin="4,0,4,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.InkSoft}" />
                <ComboBox x:Name="MinuteBox"
                          Grid.Column="3"
                          Width="64"
                          VerticalAlignment="Center"
                          Style="{StaticResource ComboBox.Flat}"
                          SelectionChanged="Time_Changed" />
                <TextBlock Grid.Column="4" x:Name="AllDayText"
                           Text="{Binding Converter={StaticResource Loc}, ConverterParameter=cal.allDay}"
                           FontSize="11" Opacity="0.65" Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.InkSoft}" />
            </Grid>

            <TextBlock x:Name="ErrorText"
                       Margin="2,8,0,0"
                       FontSize="11"
                       Foreground="#FFC0392B"
                       Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="{Binding Converter={StaticResource Loc}, ConverterParameter=common.cancel}" Style="{StaticResource Button.Ghost}" Click="Cancel_Click" />
                <Button Content="{Binding Converter={StaticResource Loc}, ConverterParameter=common.ok}" Style="{StaticResource Button.Primary}" Margin="8,0,0,0"
                        Click="Ok_Click" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
