<Window x:Class="StickyTodo.App.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入"
        Width="360"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Brush.Paper}"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True">
    <StackPanel Margin="18">
        <TextBlock x:Name="LabelText" Margin="0,0,0,8" Foreground="{StaticResource Brush.Ink}" />
        <TextBox x:Name="Input" Style="{StaticResource TextBox.Flat}" />
        <TextBlock x:Name="ErrorText"
                   Margin="0,8,0,0"
                   FontSize="11"
                   Foreground="#FFC0392B"
                   Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource Button.Ghost}" Click="Cancel_Click" />
            <Button Content="确定" Style="{StaticResource Button.Primary}" Margin="8,0,0,0" Click="Ok_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>