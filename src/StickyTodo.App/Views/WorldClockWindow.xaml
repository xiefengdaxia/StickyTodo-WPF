<Window x:Class="StickyTodo.App.Views.WorldClockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="世界时钟"
        Icon="/Assets/stickytodo.ico"
        Width="520" Height="640"
        MinWidth="420" MinHeight="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True">

    <Border x:Name="NoteRoot"
            Margin="10"
            CornerRadius="12"
            Background="{DynamicResource Brush.Paper}"
            BorderBrush="#59FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.30" Color="#FF000000" Direction="270" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.PaperDeep}"
                    CornerRadius="11,11,0,0"
                    Padding="12,8"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🌍" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="世界时钟" Style="{StaticResource Text.Title}"
                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource Button.Chrome}" Content="🎨" FontSize="11"
                                ToolTip="皮肤与透明度" Click="Appearance_Click" />
                        <Button Style="{StaticResource Button.Chrome}" Content="✕" FontSize="11"
                                ToolTip="关闭" Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,8,10,10">
                <ItemsControl ItemsSource="{Binding Clocks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2,3" Padding="14,9" CornerRadius="9"
                                    Background="{DynamicResource Brush.Surface}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CityName}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Ink}" />
                                        <TextBlock Text="{Binding CountryName}" Style="{StaticResource Text.Caption}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding DateText}" Style="{StaticResource Text.Caption}"
                                               VerticalAlignment="Center" Margin="0,0,14,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="22" FontWeight="Light"
                                               Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
