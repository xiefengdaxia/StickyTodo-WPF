<Window x:Class="StickyTodo.App.Views.BoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding BoardName}"
        Width="380" Height="520"
        MinWidth="300" MinHeight="240"
        Background="{StaticResource Brush.Paper}"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{StaticResource Brush.PaperDeep}" Padding="14,10">
            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding BoardName}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Ink}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="拖动标题可移动 · 靠近边缘或其它便签会自动对齐"
                               Style="{StaticResource Text.Caption}"
                               Margin="0,3,0,0" />
                </StackPanel>
                <Button Content="⋯"
                        ToolTip="打开看板管理"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        FontSize="14"
                        Style="{StaticResource Button.Link}"
                        Click="OpenManager_Click" />
            </Grid>
        </Border>

        <!-- 标签筛选 -->
        <Grid Grid.Row="1" Margin="14,10,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ItemsControl Grid.Column="0" ItemsSource="{Binding Chips}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Chip}"
                                Click="Chip_Click"
                                MouseRightButtonUp="Chip_RightButtonUp">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center"
                                         Fill="{Binding Color}" />
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="{Binding Count, StringFormat=' {0}'}" Opacity="0.6" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Grid.Column="1"
                    Content="＋标签"
                    VerticalAlignment="Top"
                    Style="{StaticResource Button.Ghost}"
                    FontSize="11"
                    Padding="9,4"
                    ToolTip="新建标签"
                    Click="AddTag_Click" />
        </Grid>

        <!-- 快速添加 -->
        <Grid Grid.Row="2" Margin="14,8,14,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Style="{StaticResource TextBox.Flat}"
                     Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="输入后按回车添加">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1" Margin="8,0,0,0"
                    Style="{StaticResource Button.Primary}"
                    Command="{Binding AddCommand}"
                    Content="添加" />
        </Grid>

        <!-- 待办列表（可拖拽排序） -->
        <Grid Grid.Row="3">
            <ListBox x:Name="TodoList"
                     ItemsSource="{Binding Rows}"
                     Background="Transparent"
                     BorderThickness="0"
                     AllowDrop="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch"
                     PreviewMouseLeftButtonDown="TodoList_PreviewMouseLeftButtonDown"
                     MouseMove="TodoList_MouseMove"
                     DragOver="TodoList_DragOver"
                     Drop="TodoList_Drop"
                     PreviewMouseRightButtonDown="TodoList_PreviewMouseRightButtonDown"
                     ContextMenuOpening="TodoList_ContextMenuOpening">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row"
                                            Padding="14,9"
                                            BorderBrush="{StaticResource Brush.Line}"
                                            BorderThickness="0,0,0,1"
                                            Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="#14B8860B" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsDone, Mode=OneWay}"
                                      Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="14" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Ink}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                    <Setter Property="Foreground" Value="#FF9A9484" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding TagText}"
                                           FontSize="10"
                                           Margin="0,2,0,0"
                                           Foreground="#FF8A6508"
                                           Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Content="✕"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Button.Link}"
                                    ToolTip="删除（右键可挂标签）"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="还没有待办，写下第一条吧"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource Brush.InkSoft}"
                       IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="4" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,0" Padding="14,8">
            <Grid>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding ErrorText}"
                               FontSize="11"
                               Foreground="#FFC0392B"
                               MaxWidth="150"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <CheckBox Content="显示已完成"
                              FontSize="11"
                              Margin="10,0,0,0"
                              IsChecked="{Binding ShowDone}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>