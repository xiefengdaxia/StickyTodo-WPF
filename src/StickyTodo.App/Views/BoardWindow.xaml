<Window x:Class="StickyTodo.App.Views.BoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding BoardName}"
        Icon="/Assets/stickytodo.ico"
        Width="360" Height="480"
        MinWidth="260" MinHeight="200"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Opacity="{Binding WindowOpacity, Mode=OneWay}"
        Topmost="{Binding IsTopmost, Mode=OneWay}"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- 外层留出阴影空间，真正的便签是里面这张圆角纸 -->
    <Border x:Name="NoteRoot"
            Margin="10"
            CornerRadius="12"
            Background="{DynamicResource Brush.Paper}"
            BorderBrush="#59FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.30" Color="#FF000000" Direction="270" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏：拖动区 + 悬浮按钮 -->
            <Border Grid.Row="0"
                    x:Name="TitleBar"
                    Background="{DynamicResource Brush.PaperDeep}"
                    CornerRadius="11,11,0,0"
                    Padding="12,6"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Text="{Binding BoardName}"
                                   Style="{StaticResource Text.Title}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <TextBlock Text=" 🔒"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   ToolTip="看板已锁定，点右上角解锁"
                                   Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- 平时淡显，鼠标移入窗口才完全显示 -->
                    <StackPanel x:Name="Chrome"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Opacity" Value="0.35" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="1" Duration="{StaticResource Motion.Base}"
                                                                     EasingFunction="{StaticResource Motion.Ease}" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="0.35" Duration="{StaticResource Motion.Slow}"
                                                                     EasingFunction="{StaticResource Motion.Ease}" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Button Style="{StaticResource Button.Chrome}"
                                ToolTip="置顶"
                                Click="ToggleTopmost_Click">
                            <TextBlock Text="📌" FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Opacity" Value="0.35" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTopmost}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>

                        <Button Style="{StaticResource Button.Chrome}"
                                Click="ToggleLock_Click">
                            <TextBlock FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="🔓" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                <Setter Property="Text" Value="🔒" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button.ToolTip>
                                <TextBlock Text="锁定看板（防止误改）" />
                            </Button.ToolTip>
                        </Button>

                        <Button Style="{StaticResource Button.Chrome}"
                                Content="🎨"
                                FontSize="11"
                                ToolTip="皮肤与透明度"
                                Click="Appearance_Click" />

                        <Button Style="{StaticResource Button.Chrome}"
                                Content="⋯"
                                FontSize="13"
                                ToolTip="看板管理与标签"
                                Click="OpenManager_Click" />

                        <Button Style="{StaticResource Button.Chrome}"
                                Content="✕"
                                FontSize="11"
                                ToolTip="关闭这个便签"
                                Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 内容区：锁定时整块禁用 -->
            <Grid Grid.Row="1" Grid.RowSpan="4" IsEnabled="{Binding IsLocked, Converter={StaticResource InverseBool}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标签筛选 -->
                <Grid Grid.Row="0" Margin="12,10,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ItemsControl x:Name="ChipList" Grid.Column="0" ItemsSource="{Binding Chips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="Chip_Click"
                                        MouseRightButtonUp="Chip_RightButtonUp"
                                        AllowDrop="True"
                                        DragEnter="Chip_DragEnter"
                                        DragLeave="Chip_DragLeave"
                                        DragOver="Chip_DragOver"
                                        Drop="Chip_Drop"
                                        ToolTip="{Binding ChipToolTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7"
                                                 Margin="0,0,5,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding Color}" />
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Text="{Binding Count, StringFormat=' {0}'}" Opacity="0.6" />
                                    </StackPanel>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Chip}">
                                            <Style.Triggers>
                                                <!-- 选中的胶囊：底色渐变成强调色，并轻微"顶"起来一下 -->
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 To="1" Duration="{StaticResource Motion.Fast}" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <Setter Property="Background" Value="{DynamicResource Brush.ChipActive}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.ChipIdle}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Grid.Column="1"
                            Content="＋标签"
                            VerticalAlignment="Top"
                            Style="{StaticResource Button.Ghost}"
                            FontSize="11"
                            Padding="8,3"
                            ToolTip="新建标签"
                            Click="AddTag_Click" />
                </Grid>

                <!-- 待办列表（表格行内编辑 + 可拖拽排序） -->
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox x:Name="TodoList"
                             Grid.Row="0"
                             ItemsSource="{Binding Rows}"
                             Background="Transparent"
                             BorderThickness="0"
                             AllowDrop="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch"
                             VerticalContentAlignment="Stretch"
                             Style="{StaticResource ListBox.Flat}"
                             PreviewMouseLeftButtonDown="TodoList_PreviewMouseLeftButtonDown"
                             DragOver="TodoList_DragOver"
                             Drop="TodoList_Drop"
                             DragLeave="TodoList_DragLeave"
                             PreviewMouseRightButtonDown="TodoList_PreviewMouseRightButtonDown"
                             ContextMenuOpening="TodoList_ContextMenuOpening">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row"
                                                    Padding="6,1,8,1"
                                                    Margin="6,0"
                                                    CornerRadius="7"
                                                    BorderBrush="{DynamicResource Brush.Line}"
                                                    BorderThickness="0,0,0,1"
                                                    Background="Transparent">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="#26FFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="#2EB27F0A" />
                                                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsDragTarget}" Value="True">
                                                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                                    <Setter TargetName="Row" Property="BorderThickness" Value="0,2,0,0" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <!-- 拖动把手 -->
                                        <ColumnDefinition Width="Auto" />
                                        <!-- 标题：占据剩余宽度，文本框本身按内容自适应 -->
                                        <ColumnDefinition Width="*" />
                                        <!-- 标签：始终固定在内容区最右侧 -->
                                        <ColumnDefinition Width="Auto" />
                                        <!-- 悬停操作按钮 -->
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- 拖动把手 -->
                                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                            x:Name="DragHandle"
                                            Width="16"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            Cursor="SizeAll"
                                            ToolTip="拖动可调整顺序；拖到上方的标签上可改标签"
                                            PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                                            PreviewMouseMove="DragHandle_PreviewMouseMove">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Ellipse Width="2" Height="2" Fill="{DynamicResource Brush.InkSoft}" Opacity="0.45" />
                                            <Ellipse Width="2" Height="2" Fill="{DynamicResource Brush.InkSoft}" Opacity="0.45" Margin="0,1.5" />
                                            <Ellipse Width="2" Height="2" Fill="{DynamicResource Brush.InkSoft}" Opacity="0.45" />
                                        </StackPanel>
                                    </Border>

                                    <!-- 标题：宽度随内容自适应（MaxWidth 防超长），点行内任意位置都能编辑 -->
                                    <TextBox Grid.Row="0" Grid.Column="1"
                                             Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                             GotKeyboardFocus="RowTitle_GotFocus"
                                             LostKeyboardFocus="RowTitle_LostFocus"
                                             PreviewKeyDown="RowTitle_PreviewKeyDown"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Center">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource TextBox.Inline}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                                        <Setter Property="Opacity" Value="0.55" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                    <!-- 标签：固定在右侧，不会被长标题挤走 -->
                                    <TextBlock Grid.Row="0" Grid.Column="2"
                                               Text="{Binding TagText}"
                                               FontSize="10"
                                               Margin="6,0,6,0"
                                               MaxWidth="96"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding TagText}"
                                               Foreground="{DynamicResource Brush.Accent}"
                                               Opacity="0.85"
                                               Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}" />

                                    <!-- 编辑错误提示 -->
                                    <TextBlock Grid.Row="0" Grid.Column="3"
                                               Text="{Binding EditError}"
                                               FontSize="10"
                                               Margin="0,0,4,0"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="#FFC0392B"
                                               Visibility="{Binding EditError, Converter={StaticResource NullToCollapsed}}" />

                                    <!-- 第二行：只在有徽标时才出现（完成时间/倒数日/提醒/重复） -->
                                    <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                               Margin="-5,1,0,0"
                                               Orientation="Horizontal"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding HasMeta, Converter={StaticResource BoolToVis}}">
                                        <Border Margin="0,0,5,0"
                                                Padding="5,1"
                                                CornerRadius="6"
                                                Background="#332E7D32"
                                                Visibility="{Binding HasDoneAt, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding DoneAtText}" FontSize="10" Foreground="#FF2E7D32" />
                                        </Border>

                                        <Border Margin="0,0,5,0"
                                                Padding="5,1"
                                                CornerRadius="6"
                                                Background="#33C0392B"
                                                Visibility="{Binding HasCountdown, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding CountdownText}" FontSize="10" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFC0392B" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <TextBlock Text="{Binding RemindText}"
                                                   FontSize="10"
                                                   Margin="0,0,5,0"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.8"
                                                   Foreground="{DynamicResource Brush.InkSoft}"
                                                   Visibility="{Binding HasReminder, Converter={StaticResource BoolToVis}}" />

                                        <Border Margin="0,0,5,0"
                                                Padding="5,1"
                                                CornerRadius="6"
                                                Background="#332E7D32"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsRecurring, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔁 " FontSize="9" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding RecurrenceText}" FontSize="10"
                                                           VerticalAlignment="Center" Foreground="#FF2E7D32" />
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>

                                    <!-- 悬停操作区（最右侧）：平时不可见，鼠标移入本行才出现 -->
                                    <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="3"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Opacity" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <!-- 淡入而不是硬切：鼠标扫过时不会"闪一下" -->
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                     To="1" Duration="{StaticResource Motion.Fast}"
                                                                                     EasingFunction="{StaticResource Motion.Ease}" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                     To="0" Duration="{StaticResource Motion.Base}"
                                                                                     EasingFunction="{StaticResource Motion.Ease}" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <!-- 未完成：✓ 标记为已办 -->
                                        <Button Style="{StaticResource Button.RowAction}"
                                                ToolTip="标记为已完成"
                                                Click="RowDone_Click"
                                                Visibility="{Binding IsDone, Converter={StaticResource InverseBoolToVis}}">
                                            <Path Data="M 0.5,5.5 L 4.2,9.2 L 10.5,2"
                                                  Stroke="{DynamicResource Brush.Accent}"
                                                  StrokeThickness="1.9"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" />
                                        </Button>

                                        <!-- 已完成：↺ 撤回为待办 -->
                                        <Button Style="{StaticResource Button.RowAction}"
                                                ToolTip="撤回为待办"
                                                Click="RowUndone_Click"
                                                Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
                                            <Path Data="M 2.5,2 L 2.5,6 L 6.5,6 M 2.9,5.9 A 4.2,4.2 0 1 0 5.4,1"
                                                  Stroke="{DynamicResource Brush.Accent}"
                                                  StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" />
                                        </Button>

                                        <!-- 两个视图都有：✕ 删除 -->
                                        <Button Style="{StaticResource Button.RowDelete}"
                                                ToolTip="删除这条待办"
                                                Click="RowDelete_Click" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 空列表提示（草稿行永远在下面，所以提示上移一点） -->
                    <TextBlock Grid.Row="0"
                               Text="{Binding EmptyHint}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,-20,0,0"
                               Foreground="{DynamicResource Brush.InkSoft}"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 末尾的「草稿行」：像表格最后一行空行，输入回车即新增 -->
                    <Border Grid.Row="1"
                            Margin="6,0,6,2"
                            Padding="12,4"
                            CornerRadius="7"
                            Background="#1AFFFFFF"
                            BorderBrush="{DynamicResource Brush.Line}"
                            BorderThickness="1"
                            MouseLeftButtonDown="DraftRow_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="＋"
                                       FontSize="12"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.InkSoft}" />

                            <TextBox x:Name="DraftBox"
                                     Grid.Column="1"
                                     Style="{StaticResource TextBox.Inline}"
                                     IsEnabled="{Binding CanAdd}"
                                     GotKeyboardFocus="DraftBox_GotFocus"
                                     LostKeyboardFocus="DraftBox_LostFocus"
                                     PreviewKeyDown="DraftBox_PreviewKeyDown">
                                <TextBox.Text>
                                    <Binding Path="DraftTitle" UpdateSourceTrigger="PropertyChanged" />
                                </TextBox.Text>
                            </TextBox>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding DraftPlaceholder}"
                                       FontSize="13"
                                       Margin="2,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Foreground="{DynamicResource Brush.InkSoft}"
                                       Opacity="0.7">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DraftTitle}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDraftFocused}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 底部：状态 + TODO/Done 视图切换 -->
                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="0,1,0,0"
                        Padding="10,6"
                        Margin="0,4,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}"
                                       Style="{StaticResource Text.Caption}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ErrorText}"
                                       FontSize="10"
                                       Foreground="#FFC0392B"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding ErrorText, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>

                        <!-- 分段切换：待办 / 已完成 -->
                        <Border Grid.Column="1"
                                CornerRadius="9"
                                Background="{DynamicResource Brush.ChipIdle}"
                                BorderBrush="{DynamicResource Brush.Line}"
                                BorderThickness="1"
                                Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="TodoTab" Style="{StaticResource SegmentTab}" Click="TodoTab_Click" ToolTip="只看未完成">
                                    <TextBlock Text="{Binding TodoViewText}" />
                                </Button>
                                <Button x:Name="DoneTab" Style="{StaticResource SegmentTab}" Click="DoneTab_Click" ToolTip="只看已完成">
                                    <TextBlock Text="{Binding DoneViewText}" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
