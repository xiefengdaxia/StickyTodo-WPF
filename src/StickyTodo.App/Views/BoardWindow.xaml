<Window x:Class="StickyTodo.App.Views.BoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding BoardName}"
        Width="360" Height="480"
        MinWidth="260" MinHeight="200"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Opacity="{Binding WindowOpacity, Mode=OneWay}"
        Topmost="{Binding IsTopmost, Mode=OneWay}"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- 外层留出阴影空间，真正的便签是里面这张圆角纸 -->
    <Border x:Name="NoteRoot"
            Margin="10"
            CornerRadius="12"
            Background="{DynamicResource Brush.Paper}"
            BorderBrush="#59FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.30" Color="#FF000000" Direction="270" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏：拖动区 + 悬浮按钮 -->
            <Border Grid.Row="0"
                    x:Name="TitleBar"
                    Background="{DynamicResource Brush.PaperDeep}"
                    CornerRadius="11,11,0,0"
                    Padding="12,8"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding BoardName}"
                                       Style="{StaticResource Text.Title}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text=" 🔒"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       ToolTip="看板已锁定，点右上角解锁"
                                       Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}"
                                   Style="{StaticResource Text.Caption}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- 平时淡显，鼠标移入窗口才完全显示 -->
                    <StackPanel x:Name="Chrome"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Opacity" Value="0.35" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Button Style="{StaticResource Button.Chrome}"
                                ToolTip="置顶"
                                Click="ToggleTopmost_Click">
                            <TextBlock Text="📌" FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Opacity" Value="0.35" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTopmost}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>

                        <Button Style="{StaticResource Button.Chrome}"
                                Click="ToggleLock_Click">
                            <TextBlock FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="🔓" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                <Setter Property="Text" Value="🔒" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button.ToolTip>
                                <TextBlock Text="锁定看板（防止误改）" />
                            </Button.ToolTip>
                        </Button>

                        <Button Style="{StaticResource Button.Chrome}"
                                Content="🎨"
                                FontSize="11"
                                ToolTip="皮肤与透明度"
                                Click="Appearance_Click" />

                        <Button Style="{StaticResource Button.Chrome}"
                                Content="⋯"
                                FontSize="13"
                                ToolTip="看板管理与标签"
                                Click="OpenManager_Click" />

                        <Button Style="{StaticResource Button.Chrome}"
                                Content="✕"
                                FontSize="11"
                                ToolTip="关闭这个便签"
                                Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 内容区：锁定时整块禁用 -->
            <Grid Grid.Row="1" Grid.RowSpan="4" IsEnabled="{Binding IsLocked, Converter={StaticResource InverseBool}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标签筛选 -->
                <Grid Grid.Row="0" Margin="12,10,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ItemsControl Grid.Column="0" ItemsSource="{Binding Chips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Chip}"
                                        Click="Chip_Click"
                                        MouseRightButtonUp="Chip_RightButtonUp">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7"
                                                 Margin="0,0,5,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding Color}" />
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Text="{Binding Count, StringFormat=' {0}'}" Opacity="0.6" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Grid.Column="1"
                            Content="＋标签"
                            VerticalAlignment="Top"
                            Style="{StaticResource Button.Ghost}"
                            FontSize="11"
                            Padding="8,3"
                            ToolTip="新建标签"
                            Click="AddTag_Click" />
                </Grid>

                <!-- 快速添加 -->
                <Grid Grid.Row="1" Margin="12,8,12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputBox"
                             Grid.Column="0"
                             Style="{StaticResource TextBox.Flat}"
                             Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="输入后按回车添加">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1" Margin="7,0,0,0"
                            Style="{StaticResource Button.Primary}"
                            Command="{Binding AddCommand}"
                            Content="添加" />
                </Grid>

                <!-- 待办列表（可拖拽排序） -->
                <Grid Grid.Row="2">
                    <ListBox x:Name="TodoList"
                             ItemsSource="{Binding Rows}"
                             Background="Transparent"
                             BorderThickness="0"
                             AllowDrop="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch"
                             PreviewMouseLeftButtonDown="TodoList_PreviewMouseLeftButtonDown"
                             MouseMove="TodoList_MouseMove"
                             DragOver="TodoList_DragOver"
                             Drop="TodoList_Drop"
                             PreviewMouseRightButtonDown="TodoList_PreviewMouseRightButtonDown"
                             ContextMenuOpening="TodoList_ContextMenuOpening">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row"
                                                    Padding="12,7"
                                                    Margin="4,0"
                                                    CornerRadius="7"
                                                    BorderBrush="{DynamicResource Brush.Line}"
                                                    BorderThickness="0,0,0,1"
                                                    Background="Transparent">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="#33FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              Margin="0,0,9,0"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsDone, Mode=OneWay}"
                                              Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding}" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="13.5" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                            <Setter Property="Opacity" Value="0.5" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Border Margin="0,0,5,0"
                                                    Padding="5,1"
                                                    CornerRadius="6"
                                                    Background="#33C0392B"
                                                    Visibility="{Binding HasCountdown, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding CountdownText}" FontSize="10">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                    <Setter Property="Foreground" Value="#FFC0392B" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <TextBlock Text="{Binding RemindText}"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"
                                                       Opacity="0.8"
                                                       Foreground="{DynamicResource Brush.InkSoft}"
                                                       Visibility="{Binding HasReminder, Converter={StaticResource BoolToVis}}" />

                                            <Border Margin="5,0,0,0"
                                                    Padding="5,1"
                                                    CornerRadius="6"
                                                    Background="#332E7D32"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsRecurring, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🔁 " FontSize="9" />
                                                    <TextBlock Text="{Binding RecurrenceText}" FontSize="10" Foreground="#FF2E7D32" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding TagText}"
                                                   FontSize="10"
                                                   Margin="0,2,0,0"
                                                   Foreground="{DynamicResource Brush.Accent}"
                                                   Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Content="✕"
                                            FontSize="11"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource Button.Link}"
                                            ToolTip="删除（右键可挂标签）"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="还没有待办，写下第一条吧"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.InkSoft}"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- 底部 -->
                <Border Grid.Row="3"
                        BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="0,1,0,0"
                        Padding="12,6"
                        Margin="0,4,0,0">
                    <Grid>
                        <TextBlock Text="右键待办可挂标签 · 拖拽排序"
                                   Style="{StaticResource Text.Caption}"
                                   Opacity="0.75"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding ErrorText}"
                                       FontSize="11"
                                       Foreground="#FFC0392B"
                                       MaxWidth="140"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <CheckBox Content="已完成"
                                      FontSize="11"
                                      Margin="8,0,0,0"
                                      IsChecked="{Binding ShowDone}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>