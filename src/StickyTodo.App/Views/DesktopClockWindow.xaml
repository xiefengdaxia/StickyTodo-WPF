<Window x:Class="StickyTodo.App.Views.DesktopClockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面时钟"
        Width="344"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- 可点击的一行：悬停时淡淡亮一下，提示"这里能点" -->
        <Style x:Key="ClockRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="3,2" />
            <Setter Property="Margin" Value="-3,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1AFFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- 窗口高度只看时钟本体（NoteRoot）：SizeToContent=Height 量的就是这个 Grid，
         而快捷列挂在 Canvas 里——Canvas 的期望尺寸恒为 0，图标再多也顶不高窗口 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 左边这一条固定留给快捷入口：平时滑出去（透明），鼠标移入时钟才滑进来，不会挡住时钟 -->
            <ColumnDefinition Width="44" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="NoteRoot"
                Grid.Column="1"
                Margin="8"
                CornerRadius="12"
                Background="#F02F2A26"
                BorderBrush="#59FFFFFF"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.35" Color="#FF000000" Direction="270" />
            </Border.Effect>

            <StackPanel Margin="16,6,16,14"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                        MouseMove="Root_MouseMove"
                        MouseLeftButtonUp="Root_MouseLeftButtonUp"
                        MouseRightButtonUp="Root_MouseRightButtonUp">

                <!-- 标题栏右侧：置顶 📌 / 锁定 🔒 / 皮肤 🎨 / 看板管理 ☰（和其它看板同一组、同一顺序） -->
                <StackPanel x:Name="Chrome"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,-6,-2">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Opacity" Value="0.35" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="{StaticResource Motion.Base}"
                                                                 EasingFunction="{StaticResource Motion.Ease}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="0.35" Duration="{StaticResource Motion.Slow}"
                                                                 EasingFunction="{StaticResource Motion.Ease}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Button x:Name="PinButton"
                            Style="{StaticResource Button.Chrome}"
                            Content="📌" FontSize="11"
                            ToolTip="置顶（其它窗口不会盖住它）" />
                    <Button x:Name="LockButton"
                            Style="{StaticResource Button.Chrome}"
                            Content="🔓" FontSize="11"
                            ToolTip="锁定穿透（锁定后点不到，用同一位置的小锁解锁）" />
                    <Button x:Name="SkinButton"
                            Style="{StaticResource Button.Chrome}"
                            Content="🎨" FontSize="11"
                            ToolTip="皮肤与透明度"
                            Click="Appearance_Click" />
                    <Button x:Name="ManageButton"
                            Style="{StaticResource Button.Chrome}"
                            Content="☰" FontSize="11"
                            ToolTip="看板管理"
                            Click="Manage_Click" />
                </StackPanel>

                <!-- 日期 + 农历：点一下打开日历 -->
                <Border Style="{StaticResource ClockRow}" Tag="calendar" ToolTip="点击打开日历">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{Binding SolarDateText}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="#FFF0E6D8" />
                            <TextBlock Text="{Binding WeekdayText}" FontSize="13"
                                       Foreground="#FFCFC3B4" HorizontalAlignment="Right" />
                        </Grid>

                        <!-- 农历 + 节气/节日 -->
                        <TextBlock Text="{Binding LunarText}" FontSize="11.5"
                                   Foreground="#FF9E9284" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- 时间 + 网速：点一下打开世界时钟（拖着不动就是拖窗口） -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding TimeText}" FontSize="38" FontWeight="Light" Tag="clock"
                               ToolTip="点击打开世界时钟"
                               Foreground="#FFF6EFE4" Margin="0,4,0,0" />
                    <!-- 网速：实时采样所有网卡，单位自动换档；点一下打开网速看板 -->
                    <TextBlock Grid.Column="2" Text="{Binding NetworkSpeedText}" FontSize="11"
                               VerticalAlignment="Bottom" Margin="0,0,2,9"
                               Foreground="#FF9E9284" Tag="network" Cursor="Hand"
                               Visibility="{Binding NetworkSpeedText, Converter={StaticResource NullToCollapsed}}"
                               ToolTip="当前网速（所有网卡合计）· 点击打开网速看板" />
                </Grid>

                <Border Height="1" Background="#26FFFFFF" Margin="0,10,0,8" />

                <!-- 天气（点一下打开天气看板） -->
                <Border Style="{StaticResource ClockRow}" Tag="weather" ToolTip="点击打开天气看板">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding WeatherLine}" FontSize="12.5"
                                   Foreground="#FFE8A85C" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding WeatherDetail}" FontSize="11"
                                   Foreground="#FF9E9284" Margin="8,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>

                <!-- 今日日程：左边点开待办，右边点开 token 看板 -->
                <Border Style="{StaticResource ClockRow}" Margin="-3,3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Tag="todo" ToolTip="点击打开待办"
                                   Text="{Binding AgendaLine}" FontSize="12"
                                   Foreground="#FFD9CEC0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Tag="token" ToolTip="点击打开 Token 用量看板"
                                   Text="{Binding BottomRightText}" FontSize="11"
                                   Foreground="#FF9E9284" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- ================= 左侧快捷入口：便签 / 番茄 / 性能 / AI 看板 + 看板管理 + 设置 =================
             绝对定位的浮层：Canvas 不把子元素的期望尺寸算进自己（Canvas 量出来的永远是 0），
             所以这一列放进多少图标都不会改变窗口高度；放不下就在列里滚动。
             ClipToBounds 保证滑出去的那一半不会漏到窗口外面。 -->
        <Canvas x:Name="QuickLayer"
                Grid.ColumnSpan="2"
                ClipToBounds="True">
            <!-- 尺寸跟着窗口走：Canvas 的子元素不会自动拉伸，套一层跟着 Canvas 大小的 Grid -->
            <Grid Width="{Binding ActualWidth, ElementName=QuickLayer}"
                  Height="{Binding ActualHeight, ElementName=QuickLayer}">

                <!-- 只在时钟左侧这 44px 里显示：滑出/滑入都贴着时钟边缘，
                     看起来像是从时钟里长出来的（而不是从屏幕左边推进来） -->
                <Grid Width="44" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                      ClipToBounds="True">

                <!-- 高度撑满整块时钟（上下留 8），内容再多也只在列里滚动 -->
                <Border x:Name="QuickBar"
                        Width="40"
                        Margin="0,8"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        CornerRadius="12"
                        Background="#CC2B2723"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        ToolTip="{Binding Converter={StaticResource Loc}, ConverterParameter=clock.quick}">
                    <Border.RenderTransform>
                        <!-- 收起时向右缩进时钟底下（被上面的 Grid 裁掉），展开时向左滑出来 -->
                        <TranslateTransform X="40" />
                    </Border.RenderTransform>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                                <!-- 鼠标进窗口（时钟或这一列）就滑进来；离开就滑出去 -->
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="{StaticResource Motion.Base}"
                                                                 EasingFunction="{StaticResource Motion.Ease}" />
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                 To="0" Duration="{StaticResource Motion.Base}"
                                                                 EasingFunction="{StaticResource Motion.Ease}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="{StaticResource Motion.Base}"
                                                                 EasingFunction="{StaticResource Motion.Ease}" />
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                 To="40" Duration="{StaticResource Motion.Base}"
                                                                 EasingFunction="{StaticResource Motion.Ease}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <!-- 用 Grid 而不是 StackPanel：星号行把剩余高度分给滚动区，
                         图标放不下就在这一列里滚，而不是把窗口顶高 -->
                    <Grid Margin="4,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 固定顺序：便签 → 番茄时钟 → 性能 → 所有 AI 看板。
                             这一列只有 40 宽，默认滚动条会把 26 的图标挤扁，所以不显示滚动条，
                             放不下的用滚轮翻（Hidden 仍然可以滚）。 -->
                        <ScrollViewer Grid.Row="0"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding QuickItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 前景色跟着皮肤深浅走（QuickInk）：这一列底色固定深色，
                                             浅色皮肤的 Brush.Ink 是近黑色，直接继承会"图标看不见"。
                                             字体走 BoardIcons（Segoe UI Symbol + Ideal 排版）：
                                             彩色 emoji 在这个 26×26 的方格里只露半个笔画。 -->
                                        <Button Style="{StaticResource Button.Chrome}"
                                                Width="26" Height="26"
                                                FontSize="13"
                                                FontFamily="{Binding GlyphFont}"
                                                TextOptions.TextFormattingMode="Ideal"
                                                Focusable="False"
                                                Margin="0,1"
                                                Content="{Binding Glyph}"
                                                Foreground="{Binding DataContext.QuickInk, RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="{Binding Name}"
                                                Click="QuickItem_Click" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Grid.Row="1" Height="1" Background="#26FFFFFF" Margin="2,4" />

                        <!-- 看板管理 -->
                        <Button x:Name="QuickManageButton"
                                Grid.Row="2"
                                Style="{StaticResource Button.Chrome}"
                                Width="26" Height="26"
                                FontSize="13"
                                Focusable="False"
                                Margin="0,1"
                                Content="☰"
                                Foreground="{Binding QuickInk}"
                                ToolTip="{Binding Converter={StaticResource Loc}, ConverterParameter=chrome.manage}"
                                Click="QuickManage_Click" />

                        <!-- 设置 -->
                        <Button x:Name="QuickSettingsButton"
                                Grid.Row="3"
                                Style="{StaticResource Button.Chrome}"
                                Width="26" Height="26"
                                FontSize="13"
                                Focusable="False"
                                Margin="0,1"
                                Content="⚙"
                                Foreground="{Binding QuickInk}"
                                ToolTip="{Binding Converter={StaticResource Loc}, ConverterParameter=settings.title}"
                                Click="QuickSettings_Click" />
                    </Grid>
                </Border>
                </Grid>
            </Grid>
        </Canvas>
    </Grid>
</Window>
