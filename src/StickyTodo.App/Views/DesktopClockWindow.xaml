<Window x:Class="StickyTodo.App.Views.DesktopClockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面时钟"
        Width="300"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- 可点击的一行：悬停时淡淡亮一下，提示"这里能点" -->
        <Style x:Key="ClockRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="3,2" />
            <Setter Property="Margin" Value="-3,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1AFFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="NoteRoot"
            Margin="8"
            CornerRadius="12"
            Background="#F02F2A26"
            BorderBrush="#59FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.35" Color="#FF000000" Direction="270" />
        </Border.Effect>

        <StackPanel Margin="16,12,16,14"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    MouseMove="Root_MouseMove"
                    MouseLeftButtonUp="Root_MouseLeftButtonUp">

            <!-- 日期 + 农历：点一下打开日历（原来的"点击打开日历"提示改到这里） -->
            <Border Style="{StaticResource ClockRow}"
                    ToolTip="点击打开日历"
                    MouseLeftButtonDown="CalendarArea_MouseLeftButtonDown"
                    MouseLeftButtonUp="CalendarArea_MouseLeftButtonUp">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding SolarDateText}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="#FFF0E6D8" />
                        <TextBlock Text="{Binding WeekdayText}" FontSize="13"
                                   Foreground="#FFCFC3B4" HorizontalAlignment="Right" />
                    </Grid>

                    <!-- 农历 + 节气/节日 -->
                    <TextBlock Text="{Binding LunarText}" FontSize="11.5"
                               Foreground="#FF9E9284" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- 时间（这一块同时是拖动窗口的把手） -->
            <TextBlock Text="{Binding TimeText}" FontSize="38" FontWeight="Light"
                       Foreground="#FFF6EFE4" Margin="0,4,0,0" />

            <Border Height="1" Background="#26FFFFFF" Margin="0,10,0,8" />

            <!-- 天气（点一下打开天气看板） -->
            <Border Style="{StaticResource ClockRow}"
                    ToolTip="点击打开天气看板"
                    MouseLeftButtonDown="WeatherRow_MouseLeftButtonDown"
                    MouseLeftButtonUp="WeatherRow_MouseLeftButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding WeatherLine}" FontSize="12.5"
                               Foreground="#FFE8A85C" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding WeatherDetail}" FontSize="11"
                               Foreground="#FF9E9284" Margin="8,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <!-- 今日日程（点一下打开日历） -->
            <Border Style="{StaticResource ClockRow}" Margin="-3,3"
                    ToolTip="点击打开日历"
                    MouseLeftButtonDown="AgendaRow_MouseLeftButtonDown"
                    MouseLeftButtonUp="AgendaRow_MouseLeftButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding AgendaLine}" FontSize="12"
                               Foreground="#FFD9CEC0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding BottomRightText}" FontSize="11"
                               Foreground="#FF9E9284" Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
