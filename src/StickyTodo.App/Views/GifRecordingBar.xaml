<Window x:Class="StickyTodo.App.Views.GifRecordingBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GIF"
        Width="520"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True">
    <Window.Resources>
        <!-- 深色悬浮条：不跟随皮肤，保证压在任意桌面上都看得清 -->
        <Style x:Key="BarText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F0FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E8FFFFFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BarStop" TargetType="Button" BasedOn="{StaticResource BarButton}">
            <Setter Property="Background" Value="#E6403A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Border Margin="6" CornerRadius="10"
            Background="#F2202124" BorderBrush="#40FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" Color="#FF000000" Direction="270" />
        </Border.Effect>

        <StackPanel Orientation="Horizontal" Margin="10,7" VerticalAlignment="Center">

            <!-- 录制红点（呼吸动画） -->
            <Ellipse x:Name="Dot" Width="10" Height="10" Fill="#FFF03A3A" VerticalAlignment="Center" />

            <!-- 倒计时数字（先占好位置，避免倒计时结束时整条抖动） -->
            <TextBlock x:Name="CountdownText" Style="{StaticResource BarText}"
                       FontSize="16" FontWeight="Bold" Foreground="#FF3FA9F5"
                       MinWidth="14" Margin="8,0,0,0" Visibility="Hidden" />

            <TextBlock x:Name="StatusText" Style="{StaticResource BarText}" Margin="8,0,0,0" />

            <TextBlock x:Name="TimeText" Style="{StaticResource BarText}" FontWeight="SemiBold"
                       FontFamily="Consolas" Margin="8,0,0,0" Text="00:00" />

            <TextBlock x:Name="FrameText" Style="{StaticResource BarText}" Opacity="0.6" Margin="8,0,0,0" />

            <Rectangle Width="1" Height="16" Fill="#40FFFFFF" Margin="10,0" />

            <TextBlock x:Name="QualityLabel" Style="{StaticResource BarText}" Opacity="0.7" />
            <ComboBox x:Name="QualityBox" Width="96" Margin="6,0,0,0" FontSize="11"
                      VerticalAlignment="Center" VerticalContentAlignment="Center"
                      Background="#33343A" Foreground="#FF202124" BorderBrush="#55FFFFFF" />

            <CheckBox x:Name="CountdownBox" Margin="12,0,0,0" FontSize="11" VerticalAlignment="Center"
                      Foreground="#E8FFFFFF" VerticalContentAlignment="Center" />

            <Rectangle Width="1" Height="16" Fill="#40FFFFFF" Margin="10,0" />

            <Button x:Name="StopButton" Click="Stop_Click" Style="{StaticResource BarStop}" />
            <Button x:Name="CloseButton" Click="Close_Click" Content="✕" Style="{StaticResource BarButton}" />
        </StackPanel>
    </Border>
</Window>
