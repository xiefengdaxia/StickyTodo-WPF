<Window x:Class="StickyTodo.App.Views.GifFrameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GIF"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        IsHitTestVisible="False"
        UseLayoutRounding="True">

    <Border x:Name="Frame" BorderBrush="#FFF03A3A" BorderThickness="2" Background="Transparent" />
</Window>
