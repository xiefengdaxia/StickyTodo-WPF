<Window x:Class="StickyTodo.App.Views.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StickyTodo"
        Icon="/Assets/stickytodo.ico"
        Height="660" Width="760"
        MinHeight="560" MinWidth="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="BoardRowPanel">
            <StackPanel />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="BoardTilePanel">
            <UniformGrid Columns="4" />
        </ItemsPanelTemplate>

        <!-- 行视图（默认） -->
<Style x:Key="BoardRowItemStyle" TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row"
                                                CornerRadius="10"
                                                Background="{DynamicResource Brush.Surface}"
                                                BorderBrush="{DynamicResource Brush.Line}"
                                                BorderThickness="1"
                                                Padding="14,11"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                            </Border.RenderTransform>
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <!-- 悬停轻微放大：卡片"浮起来"一点点，比只换底色明显 -->
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Row"
                                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                             To="1.012" Duration="{StaticResource Motion.Fast}"
                                                                             EasingFunction="{StaticResource Motion.Ease}" />
                                                            <DoubleAnimation Storyboard.TargetName="Row"
                                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                             To="1.012" Duration="{StaticResource Motion.Fast}"
                                                                             EasingFunction="{StaticResource Motion.Ease}" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Row"
                                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                             To="1" Duration="{StaticResource Motion.Base}"
                                                                             EasingFunction="{StaticResource Motion.Ease}" />
                                                            <DoubleAnimation Storyboard.TargetName="Row"
                                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                             To="1" Duration="{StaticResource Motion.Base}"
                                                                             EasingFunction="{StaticResource Motion.Ease}" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                                <Setter TargetName="Row" Property="Background" Value="#33B27F0A" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

<DataTemplate x:Key="BoardRowTemplate">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 类型图标方块 -->
        <Border Grid.Column="0"
                Width="34" Height="34"
                CornerRadius="9"
                Background="{DynamicResource Brush.AccentSoft}"
                VerticalAlignment="Center"
                Margin="0,0,11,0">
            <TextBlock Text="{Binding KindGlyph}"
                       FontSize="15"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.Accent}" />
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Ink}"
                           TextTrimming="CharacterEllipsis" />
                <Border Margin="7,0,0,0"
                        Padding="6,1"
                        CornerRadius="5"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Brush.ChipIdle}">
                    <TextBlock Text="{Binding KindText}" FontSize="9.5"
                               Foreground="{DynamicResource Brush.InkSoft}" />
                </Border>
            </StackPanel>
            <TextBlock Text="{Binding Summary}"
                       Style="{StaticResource Text.Caption}"
                       Margin="0,3,0,0" />
        </StackPanel>

        <!-- 完成度读数：顺带把右侧那段空白填掉 -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,10,0">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowProgress}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <ProgressBar Width="96" Height="4"
                         Minimum="0" Maximum="100"
                         Value="{Binding DonePercent, Mode=OneWay}"
                         Foreground="{DynamicResource Brush.Accent}"
                         Background="{DynamicResource Brush.ChipIdle}"
                         BorderThickness="0"
                         VerticalAlignment="Center" />
            <TextBlock Text="{Binding PercentText}"
                       FontSize="10.5" MinWidth="34" TextAlignment="Right"
                       VerticalAlignment="Center" Margin="8,0,0,0"
                       Foreground="{DynamicResource Brush.InkSoft}" />
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding WindowHint}"
                       FontSize="10"
                       Foreground="{DynamicResource Brush.Accent}"
                       VerticalAlignment="Center"
                       Margin="0,0,7,0" />
            <Button Content="✕"
                    FontSize="11"
                    Style="{StaticResource Button.Link}"
                    ToolTip="{Binding Converter={StaticResource Loc}, ConverterParameter=manager.deleteBoard}"
                    Click="DeleteRow_Click" />
        </StackPanel>
    </Grid>
</DataTemplate>

        <!-- 图标网格视图 -->
<Style x:Key="BoardTileItemStyle" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Row"
                        MinHeight="96"
                        Margin="4"
                        Padding="10,12"
                        CornerRadius="10"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="1">
                    <ContentPresenter VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        <Setter TargetName="Row" Property="Background" Value="#33B27F0A" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>
<DataTemplate x:Key="BoardTileTemplate">
    <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding KindGlyph}" FontSize="24"
                   HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" />
        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"
                   HorizontalAlignment="Center" TextAlignment="Center"
                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Ink}" />
        <TextBlock Text="{Binding Summary}" FontSize="9.5" Margin="0,4,0,0"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                   MaxHeight="26" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource Brush.InkSoft}" />
    </StackPanel>
</DataTemplate>
    </Window.Resources>

    <Border x:Name="Shell"
            Margin="12"
            CornerRadius="14"
            Background="{DynamicResource Brush.PaperOpaque}"
            BorderBrush="#59FFFFFF"
            BorderThickness="1"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.30" Color="#FF000000" Direction="270" />
        </Border.Effect>

        <Grid AllowDrop="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ 左侧：品牌 + 操作 ============ -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Brush.PaperDeep}"
                    CornerRadius="13,0,0,13"
                    Padding="16,18,14,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="9"
                                    Background="{DynamicResource Brush.Accent}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="S" FontSize="16" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="StickyTodo" Style="{StaticResource Text.Title}" />
                                <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=manager.title}" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                        </StackPanel>

                        <Border Margin="0,12,0,0" Padding="9,6" CornerRadius="8"
                                Background="{DynamicResource Brush.AccentSoft}">
                            <TextBlock Text="{Binding EntitlementBadge}" FontSize="10.5"
                                       Foreground="{DynamicResource Brush.Accent}"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                    </StackPanel>

                    <!-- 中间区：按钮多了会超高，用 ScrollViewer 保证底部「设置 / 退出」永远可见 -->
                    <ScrollViewer Grid.Row="1" Margin="0,18,0,0"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                        <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=manager.new}" Style="{StaticResource Text.Section}" Margin="2,0,0,7" />
                        <Button Content="{Binding Converter={StaticResource Loc}, ConverterParameter=manager.newTodo}" Style="{StaticResource Button.Primary}"
                                HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,6"
                                Click="CreateTodo_Click" />
                        <Button Content="{Binding Converter={StaticResource Loc}, ConverterParameter=manager.newMemo}" Style="{StaticResource Button.Ghost}"
                                HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,6"
                                Click="CreateMemo_Click" />
                        <Button Content="{Binding Converter={StaticResource Loc}, ConverterParameter=manager.newCalendar}" Style="{StaticResource Button.Ghost}"
                                HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,6"
                                Click="CreateCalendar_Click" />
                        <Button Content="{Binding Converter={StaticResource Loc}, ConverterParameter=manager.newToken}" Style="{StaticResource Button.Ghost}"
                                HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,6"
                                Click="CreateToken_Click" />

                        <Button Content="{Binding Converter={StaticResource Loc}, ConverterParameter=manager.newWeather}" Style="{StaticResource Button.Ghost}"
                                HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,6"
                                Click="CreateWeather_Click" />
                        <Button Content="{Binding Converter={StaticResource Loc}, ConverterParameter=manager.newWorldClock}" Style="{StaticResource Button.Ghost}"
                                HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,6"
                                Click="CreateWorldClock_Click" />
                        <Button Content="{Binding Converter={StaticResource Loc}, ConverterParameter=manager.newDesktopClock}" Style="{StaticResource Button.Ghost}"
                                HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,6"
                                Click="CreateDesktopClock_Click" />
                        <Button Content="{Binding Converter={StaticResource Loc}, ConverterParameter=manager.newNetworkSpeed}" Style="{StaticResource Button.Ghost}"
                                HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,6"
                                Click="CreateNetworkSpeed_Click" />
                        <Button Content="{Binding Converter={StaticResource Loc}, ConverterParameter=manager.newPerformance}" Style="{StaticResource Button.Ghost}"
                                HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,6"
                                Click="CreatePerformance_Click" />
                        <Button Content="{Binding Converter={StaticResource Loc}, ConverterParameter=manager.newCustom}" Style="{StaticResource Button.Ghost}"
                                HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,6"
                                Click="CreateCustom_Click" />
                        <Button Style="{StaticResource Button.Ghost}"
                                HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,14"
                                Click="Market_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧩" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=market.title}"
                                           Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=manager.selected}" Style="{StaticResource Text.Section}" Margin="2,0,0,7" />
                        <Button Content="{Binding Converter={StaticResource Loc}, ConverterParameter=common.rename}" Style="{StaticResource Button.Ghost}"
                                HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,6"
                                Click="Rename_Click" />
                        <Button Content="{Binding Converter={StaticResource Loc}, ConverterParameter=common.delete}" Style="{StaticResource Button.Ghost}"
                                HorizontalContentAlignment="Left" Padding="12,8"
                                Click="Delete_Click" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2">
                        <Border Height="1" Background="{DynamicResource Brush.Line}" Margin="0,0,0,10" />
                        <Button Content="{Binding Converter={StaticResource Loc}, ConverterParameter=common.settings}" Style="{StaticResource Button.Ghost}"
                                HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,6"
                                Click="OpenSettings_Click" />
                        <Button x:Name="CheckUpdatesButton"
                                Content="{Binding Converter={StaticResource Loc}, ConverterParameter=update.check}"
                                Style="{StaticResource Button.Ghost}"
                                HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,6"
                                Click="CheckUpdates_Click" />
                        <Button Content="{Binding Converter={StaticResource Loc}, ConverterParameter=common.exit}" Style="{StaticResource Button.Ghost}"
                                HorizontalContentAlignment="Left" Padding="12,8"
                                Foreground="#FFC0392B"
                                Click="Exit_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ 右侧：看板列表 ============ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 顶部：标题 + 窗口按钮 -->
                <Grid Grid.Row="0" Margin="18,16,16,6" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel>
                        <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=manager.boards}" Style="{StaticResource Text.Display}" FontSize="17" />
                        <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=manager.listHint}"
                                   Style="{StaticResource Text.Caption}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <!-- 列表 / 图标网格切换：图标显示"切过去之后"的样子 -->
                        <Button Style="{StaticResource Button.Chrome}" Content="{Binding ViewToggleGlyph}" FontSize="13"
                                Margin="0,0,4,0"
                                ToolTip="{Binding ViewToggleHint}" Click="ViewToggle_Click" />
                        <Button Style="{StaticResource Button.Chrome}" Content="－" FontSize="13"
                                ToolTip="{Binding Converter={StaticResource Loc}, ConverterParameter=manager.minimize}" Click="Minimize_Click" />
                        <Button Style="{StaticResource Button.Chrome}" Content="□" FontSize="11"
                                ToolTip="{Binding Converter={StaticResource Loc}, ConverterParameter=manager.maximize}" Click="Maximize_Click" />
                        <Button Style="{StaticResource Button.ChromeClose}" Content="✕" FontSize="11"
                                ToolTip="{Binding Converter={StaticResource Loc}, ConverterParameter=manager.toTray}" Click="Hide_Click" />
                    </StackPanel>
                </Grid>

                <!-- 看板卡片列表 -->
                <ListBox x:Name="BoardList"
                         ItemsPanel="{StaticResource BoardRowPanel}"
                         ItemTemplate="{StaticResource BoardRowTemplate}"
                         ItemContainerStyle="{StaticResource BoardRowItemStyle}"
                         Grid.Row="1"
                         Margin="18,8,18,0"
                         ItemsSource="{Binding Boards}"
                         SelectedItem="{Binding SelectedBoard, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         MouseDoubleClick="BoardList_MouseDoubleClick"
                         PreviewMouseRightButtonDown="BoardList_PreviewMouseRightButtonDown"
                         ContextMenuOpening="BoardList_ContextMenuOpening"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{Binding Converter={StaticResource Loc}, ConverterParameter=menu.open}" Click="RowMenuOpen_Click" />
                            <Separator />
                            <!-- 换个图标：只有 AI 看板（Custom）才显示，列表 / 图标网格两种视图都能用 -->
                            <MenuItem x:Name="RowMenuIcon"
                                      Header="{Binding Converter={StaticResource Loc}, ConverterParameter=menu.changeIcon}"
                                      Click="RowMenuIcon_Click" />
                            <MenuItem Header="{Binding Converter={StaticResource Loc}, ConverterParameter=menu.renameEllipsis}" Click="RowMenuRename_Click" />
                            <MenuItem Header="{Binding Converter={StaticResource Loc}, ConverterParameter=common.delete}" Click="RowMenuDelete_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    

                    
                </ListBox>

                <!-- 空状态 -->
                <TextBlock Grid.Row="1"
                           Text="{Binding Converter={StaticResource Loc}, ConverterParameter=manager.empty}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.InkSoft}"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Boards.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="0,1,0,0"
                        Padding="18,9"
                        Margin="0,10,0,0">
                    <Grid>
                        <TextBlock Text="{Binding FooterHint}"
                                   Style="{StaticResource Text.Caption}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,120,0"
                                   ToolTip="{Binding FooterHint}" />
                        <TextBlock Text="{Binding ErrorText}"
                                   HorizontalAlignment="Right"
                                   FontSize="11"
                                   Foreground="#FFC0392B"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>