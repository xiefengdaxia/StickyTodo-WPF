<Window x:Class="StickyTodo.App.Views.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StickyTodo"
        Height="580" Width="820"
        MinHeight="460" MinWidth="680"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Border x:Name="Shell"
            Margin="12"
            CornerRadius="14"
            Background="{DynamicResource Brush.Paper}"
            BorderBrush="#59FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.34" Color="#FF000000" Direction="270" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ 左侧：品牌 + 操作 ============ -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Brush.PaperDeep}"
                    CornerRadius="13,0,0,13"
                    Padding="16,18,14,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="9"
                                    Background="{DynamicResource Brush.Accent}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="S" FontSize="16" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="StickyTodo" Style="{StaticResource Text.Title}" />
                                <TextBlock Text="本机便签" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                        </StackPanel>

                        <Border Margin="0,12,0,0" Padding="9,6" CornerRadius="8"
                                Background="{DynamicResource Brush.AccentSoft}">
                            <TextBlock Text="{Binding EntitlementBadge}" FontSize="10.5"
                                       Foreground="{DynamicResource Brush.Accent}"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,18,0,0">
                        <TextBlock Text="新建" Style="{StaticResource Text.Section}" Margin="2,0,0,7" />
                        <Button Content="+  待办看板" Style="{StaticResource Button.Primary}"
                                HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,6"
                                Click="CreateTodo_Click" />
                        <Button Content="+  便签看板" Style="{StaticResource Button.Ghost}"
                                HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,6"
                                Click="CreateMemo_Click" />
                        <Button Content="+  日历看板" Style="{StaticResource Button.Ghost}"
                                HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,14"
                                Click="CreateCalendar_Click" />

                        <TextBlock Text="选中的看板" Style="{StaticResource Text.Section}" Margin="2,0,0,7" />
                        <Button Content="重命名" Style="{StaticResource Button.Ghost}"
                                HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,6"
                                Click="Rename_Click" />
                        <Button Content="删除" Style="{StaticResource Button.Ghost}"
                                HorizontalContentAlignment="Left" Padding="12,8"
                                Click="Delete_Click" />
                    </StackPanel>

                    <StackPanel Grid.Row="3">
                        <Border Height="1" Background="{DynamicResource Brush.Line}" Margin="0,0,0,10" />
                        <Button Content="设置" Style="{StaticResource Button.Ghost}"
                                HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,6"
                                Click="OpenSettings_Click" />
                        <Button Content="退出" Style="{StaticResource Button.Ghost}"
                                HorizontalContentAlignment="Left" Padding="12,8"
                                Foreground="#FFC0392B"
                                Click="Exit_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ 右侧：看板列表 ============ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 顶部：标题 + 窗口按钮 -->
                <Grid Grid.Row="0" Margin="18,16,16,6" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel>
                        <TextBlock Text="我的看板" Style="{StaticResource Text.Display}" FontSize="17" />
                        <TextBlock Text="双击打开 · 右键可重命名或删除"
                                   Style="{StaticResource Text.Caption}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Style="{StaticResource Button.Chrome}" Content="－" FontSize="13"
                                ToolTip="最小化" Click="Minimize_Click" />
                        <Button Style="{StaticResource Button.Chrome}" Content="□" FontSize="11"
                                ToolTip="最大化 / 还原" Click="Maximize_Click" />
                        <Button Style="{StaticResource Button.ChromeClose}" Content="✕" FontSize="11"
                                ToolTip="收到托盘" Click="Hide_Click" />
                    </StackPanel>
                </Grid>

                <!-- 看板卡片列表 -->
                <ListBox x:Name="BoardList"
                         Grid.Row="1"
                         Margin="18,8,18,0"
                         ItemsSource="{Binding Boards}"
                         SelectedItem="{Binding SelectedBoard, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         MouseDoubleClick="BoardList_MouseDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row"
                                                CornerRadius="10"
                                                Background="{DynamicResource Brush.Surface}"
                                                BorderBrush="{DynamicResource Brush.Line}"
                                                BorderThickness="1"
                                                Padding="14,11">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                                <Setter TargetName="Row" Property="Background" Value="#33B27F0A" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 类型图标方块 -->
                                <Border Grid.Column="0"
                                        Width="34" Height="34"
                                        CornerRadius="9"
                                        Background="{DynamicResource Brush.AccentSoft}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,11,0">
                                    <TextBlock Text="{Binding KindGlyph}"
                                               FontSize="15"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Accent}" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Ink}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Margin="7,0,0,0"
                                                Padding="6,1"
                                                CornerRadius="5"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource Brush.ChipIdle}">
                                            <TextBlock Text="{Binding KindText}" FontSize="9.5"
                                                       Foreground="{DynamicResource Brush.InkSoft}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Summary}"
                                               Style="{StaticResource Text.Caption}"
                                               Margin="0,3,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding WindowHint}"
                                               FontSize="10"
                                               Foreground="{DynamicResource Brush.Accent}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,7,0" />
                                    <Button Content="✕"
                                            FontSize="11"
                                            Style="{StaticResource Button.Link}"
                                            ToolTip="删除这个看板"
                                            Click="DeleteRow_Click" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 空状态 -->
                <TextBlock Grid.Row="1"
                           Text="还没有看板，先从左边新建一个吧"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.InkSoft}"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Boards.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="0,1,0,0"
                        Padding="18,9"
                        Margin="0,10,0,0">
                    <Grid>
                        <TextBlock Text="{Binding FooterHint}"
                                   Style="{StaticResource Text.Caption}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,120,0"
                                   ToolTip="{Binding FooterHint}" />
                        <TextBlock Text="{Binding ErrorText}"
                                   HorizontalAlignment="Right"
                                   FontSize="11"
                                   Foreground="#FFC0392B"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>