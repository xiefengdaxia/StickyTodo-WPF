<Window x:Class="StickyTodo.App.Views.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding BoardName}"
        Icon="/Assets/stickytodo.ico"
        Width="520" Height="620"
        MinWidth="420" MinHeight="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Opacity="{Binding WindowOpacity, Mode=OneWay}"
        Topmost="{Binding IsTopmost, Mode=OneWay}"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Border x:Name="NoteRoot"
            Margin="10"
            CornerRadius="12"
            Background="{DynamicResource Brush.Paper}"
            BorderBrush="#59FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.30" Color="#FF000000" Direction="270" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.PaperDeep}"
                    CornerRadius="11,11,0,0"
                    Padding="12,8"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding BoardName}" Style="{StaticResource Text.Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text=" 🔒" FontSize="11" VerticalAlignment="Center"
                                       Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Opacity" Value="0.35" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Button Style="{StaticResource Button.Chrome}" ToolTip="置顶" Click="ToggleTopmost_Click">
                            <TextBlock Text="📌" FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Opacity" Value="0.35" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTopmost}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Style="{StaticResource Button.Chrome}" ToolTip="锁定" Click="ToggleLock_Click">
                            <TextBlock FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="🔓" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                <Setter Property="Text" Value="🔒" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Style="{StaticResource Button.Chrome}" Content="🎨" FontSize="11" ToolTip="皮肤与透明度" Click="Appearance_Click" />
                        <Button Style="{StaticResource Button.Chrome}" Content="⋯" FontSize="13" ToolTip="看板管理" Click="OpenManager_Click" />
                        <Button Style="{StaticResource Button.Chrome}" Content="✕" FontSize="11" ToolTip="关闭" Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 月份导航 + 网格 -->
            <Grid Grid.Row="1" Margin="10,8,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,2,6">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="‹" Style="{StaticResource Button.Ghost}" Padding="10,2" Click="PrevMonth_Click" ToolTip="上个月" />
                        <TextBlock Text="{Binding MonthTitle}" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="10,0"
                                   Foreground="{DynamicResource Brush.Ink}" />
                        <Button Content="›" Style="{StaticResource Button.Ghost}" Padding="10,2" Click="NextMonth_Click" ToolTip="下个月" />
                    </StackPanel>
                    <Button Content="今天" HorizontalAlignment="Right" Style="{StaticResource Button.Ghost}"
                            Padding="10,2" FontSize="11" Click="Today_Click" />
                </Grid>

                <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,4">
                    <TextBlock Text="一" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                    <TextBlock Text="二" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                    <TextBlock Text="三" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                    <TextBlock Text="四" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                    <TextBlock Text="五" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                    <TextBlock Text="六" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                    <TextBlock Text="日" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                </UniformGrid>

                <ItemsControl Grid.Row="2" ItemsSource="{Binding Days}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" Rows="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Cell"
                                    Margin="1"
                                    CornerRadius="6"
                                    BorderThickness="1"
                                    BorderBrush="Transparent"
                                    Background="Transparent"
                                    MouseLeftButtonDown="Cell_Click"
                                    AllowDrop="True"
                                    DragOver="Cell_DragOver"
                                    Drop="Cell_Drop"
                                    Cursor="Hand">
                                <StackPanel Margin="4,3">
                                    <TextBlock x:Name="DayNumber"
                                               Text="{Binding DayText}"
                                               FontSize="11"
                                               HorizontalAlignment="Left"
                                               Foreground="{DynamicResource Brush.Ink}" />
                                    <StackPanel x:Name="EntryHint"
                                                Orientation="Horizontal"
                                                Margin="0,3,0,0"
                                                Visibility="Collapsed">
                                        <Ellipse Width="5" Height="5" VerticalAlignment="Center"
                                                 Fill="{DynamicResource Brush.Accent}" />
                                        <TextBlock Text="{Binding Summary}"
                                                   FontSize="9"
                                                   Margin="4,0,0,0"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Brush.Accent}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                    <Setter TargetName="DayNumber" Property="Opacity" Value="0.3" />
                                    <Setter TargetName="EntryHint" Property="Opacity" Value="0.4" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                    <Setter TargetName="DayNumber" Property="Foreground" Value="#FFC0392B" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                    <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                    <Setter TargetName="Cell" Property="Background" Value="#2EB27F0A" />
                                    <Setter TargetName="DayNumber" Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasEntries}" Value="True">
                                    <Setter TargetName="EntryHint" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- 当日日程 -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="0,1,0,0"
                    Margin="0,8,0,0"
                    Padding="10,6"
                    Background="#14FFFFFF">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding SelectedDateText}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Ink}" Margin="2,0,0,4" />

                    <ScrollViewer Grid.Row="1" MaxHeight="120" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DayEntryList" ItemsSource="{Binding SelectedDayEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="EntryRow"
                                            Margin="1"
                                            Padding="4,3"
                                            CornerRadius="6"
                                            Background="Transparent"
                                            Cursor="Hand"
                                            PreviewMouseLeftButtonDown="Entry_PreviewMouseLeftButtonDown"
                                            MouseMove="Entry_MouseMove">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" Margin="0,0,7,0" VerticalAlignment="Center"
                                                      IsChecked="{Binding IsDone, Mode=OneWay}"
                                                      Click="EntryCheck_Click" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding TimeText}" FontSize="10"
                                                               Foreground="{DynamicResource Brush.Accent}" Margin="0,0,5,0" />
                                                    <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource Brush.Ink}" />
                                                    <TextBlock Text="{Binding BoardTag}" FontSize="9" Margin="5,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="#FF2E7D32" />
                                                </StackPanel>
                                            </StackPanel>

                                            <Button Grid.Column="2" Content="✕" FontSize="10"
                                                    Style="{StaticResource Button.Link}"
                                                    ToolTip="删除"
                                                    Click="DeleteEntry_Click" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="EntryRow" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="EntryRow" Property="Background" Value="#26FFFFFF" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="1" Text="这一天没有日程"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,6"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedDayEntries.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- 底部提示 -->
            <Border Grid.Row="3" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="12,6">
                <Grid>
                    <TextBlock Text="{Binding ErrorText}" FontSize="11" Foreground="#FFC0392B" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="把待办从列表拖到日期格 = 改期" Style="{StaticResource Text.Caption}"
                               HorizontalAlignment="Right" Opacity="0.75" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>