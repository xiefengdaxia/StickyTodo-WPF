<Window x:Class="StickyTodo.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Converter={StaticResource Loc}, ConverterParameter=settings.title}"
        Icon="/Assets/stickytodo.ico"
        Width="520" Height="700"
        MinWidth="460" MinHeight="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Border x:Name="Shell"
            Margin="12"
            CornerRadius="14"
            Background="{DynamicResource Brush.PaperOpaque}"
            BorderBrush="#59FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.30" Color="#FF000000" Direction="270" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 自绘标题栏 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.PaperDeep}"
                    CornerRadius="13,13,0,0"
                    Padding="18,14"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=settings.title}" Style="{StaticResource Text.Display}" />
                        <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=settings.subtitle}"
                                   Style="{StaticResource Text.Caption}"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Style="{StaticResource Button.ChromeClose}"
                                Content="✕"
                                FontSize="11"
                                ToolTip="{Binding Converter={StaticResource Loc}, ConverterParameter=chrome.close}"
                                Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,14,10,14">
                <StackPanel>

                    <!-- ===== 外观：皮肤 ===== -->
                    <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=settings.appearance}" Style="{StaticResource Text.Section}" Margin="2,0,0,8" />

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=settings.palette}" Style="{StaticResource Text.Title}" FontSize="13" Margin="0,0,0,3" />
                            <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=settings.paletteHint}"
                                       Style="{StaticResource Text.Caption}"
                                       Margin="0,0,0,12" />

                            <ItemsControl x:Name="SkinList" ItemsSource="{Binding Skins}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,8,8"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                ToolTip="{Binding Name}"
                                                Click="Skin_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Root"
                                                            Width="72"
                                                            CornerRadius="9"
                                                            BorderThickness="2"
                                                            BorderBrush="Transparent"
                                                            Padding="5">
                                                        <StackPanel>
                                                            <Border Height="34"
                                                                    CornerRadius="6"
                                                                    Background="{Binding Preview}"
                                                                    BorderBrush="#33000000"
                                                                    BorderThickness="1">
                                                                <TextBlock Text="Aa"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{Binding TextPreview}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="10.5"
                                                                       HorizontalAlignment="Center"
                                                                       Margin="0,5,0,0"
                                                                       Foreground="{DynamicResource Brush.InkSoft}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Root" Property="Background" Value="#26FFFFFF" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                                            <Setter TargetName="Root" Property="Background" Value="#33B27F0A" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ===== 外观：语言 ===== -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=settings.language}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Ink}" />
                                <ComboBox x:Name="LanguageBox"
                                          HorizontalAlignment="Right"
                                          Width="132"
                                          ItemsSource="{Binding Languages}"
                                          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                          SelectionChanged="LanguageBox_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource LocLanguage}}" FontSize="12" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=settings.languageHint}"
                                       Style="{StaticResource Text.Caption}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- ===== 外观：透明度 ===== -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=settings.bgOpacity}" Style="{StaticResource Text.Title}" FontSize="13" />
                                <TextBlock Text="{Binding BackgroundOpacityText}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Accent}" />
                            </Grid>
                            <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=settings.bgOpacityHint}"
                                       Style="{StaticResource Text.Caption}"
                                       Margin="0,0,0,6" />
                            <Slider Style="{StaticResource Slider.Slim}"
                                    Minimum="10"
                                    Maximum="100"
                                    TickFrequency="1"
                                    SmallChange="1"
                                    LargeChange="5"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding BackgroundOpacity, Mode=TwoWay}" />

                            <Border Height="1" Background="{DynamicResource Brush.Line}" Margin="0,10" />

                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=settings.winOpacity}" Style="{StaticResource Text.Title}" FontSize="13" />
                                <TextBlock Text="{Binding WindowOpacityText}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Accent}" />
                            </Grid>
                            <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=settings.winOpacityHint}"
                                       Style="{StaticResource Text.Caption}"
                                       Margin="0,0,0,6" />
                            <Slider Style="{StaticResource Slider.Slim}"
                                    Minimum="10"
                                    Maximum="100"
                                    TickFrequency="1"
                                    SmallChange="1"
                                    LargeChange="5"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding WindowOpacity, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <!-- ===== 启动 ===== -->
                    <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=settings.startup}" Style="{StaticResource Text.Section}" Margin="2,4,0,8" />

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <CheckBox Style="{StaticResource CheckBox.Labeled}"
                                      Content="{Binding Converter={StaticResource Loc}, ConverterParameter=settings.autoStart}"
                                      FontSize="12.5"
                                      IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}" />
                            <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=settings.autoStartHint}"
                                       Style="{StaticResource Text.Caption}"
                                       Margin="24,5,0,0" />

                            <Border Height="1" Background="{DynamicResource Brush.Line}" Margin="0,11" />

                            <CheckBox Style="{StaticResource CheckBox.Labeled}"
                                      Content="{Binding Converter={StaticResource Loc}, ConverterParameter=settings.restoreSession}"
                                      FontSize="12.5"
                                      IsChecked="{Binding RestoreSession, Mode=TwoWay}" />
                            <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=settings.restoreSessionHint}"
                                       Style="{StaticResource Text.Caption}"
                                       Margin="24,5,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- ===== Token 用量 ===== -->
                    <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=settings.token}" Style="{StaticResource Text.Section}" Margin="2,4,0,8" />

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=settings.tokenDb}" FontSize="12.5" Foreground="{DynamicResource Brush.Ink}" />
                            <TextBox x:Name="TokenDatabaseBox"
                                     Text="{Binding TokenDatabasePath, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextBox.Flat}"
                                     Margin="0,6,0,0"
                                     ToolTip="{Binding Converter={StaticResource Loc}, ConverterParameter=settings.tokenDbTip}"
                                     LostFocus="TokenDatabaseBox_LostFocus"
                                     KeyDown="TokenDatabaseBox_KeyDown" />
                            <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=settings.tokenDbHint}"
                                       Style="{StaticResource Text.Caption}"
                                       TextWrapping="Wrap"
                                       Margin="2,5,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- ===== 快捷键 ===== -->
                    <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=settings.shortcuts}" Style="{StaticResource Text.Section}" Margin="2,4,0,8" />

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,9">
                                <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=settings.scNewTodo}" FontSize="12.5" Foreground="{DynamicResource Brush.Ink}" />
                                <Border HorizontalAlignment="Right" Background="{DynamicResource Brush.AccentSoft}"
                                        CornerRadius="6" Padding="8,2">
                                    <TextBlock Text="{Binding ShortcutNewTodo}" FontSize="11"
                                               Foreground="{DynamicResource Brush.Accent}" />
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,0,9">
                                <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=settings.scToggle}" FontSize="12.5" Foreground="{DynamicResource Brush.Ink}" />
                                <Border HorizontalAlignment="Right" Background="{DynamicResource Brush.AccentSoft}"
                                        CornerRadius="6" Padding="8,2">
                                    <TextBlock Text="{Binding ShortcutToggleBoards}" FontSize="11"
                                               Foreground="{DynamicResource Brush.Accent}" />
                                </Border>
                            </Grid>
                            <Grid>
                                <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=settings.scLock}" FontSize="12.5" Foreground="{DynamicResource Brush.Ink}" />
                                <Border HorizontalAlignment="Right" Background="{DynamicResource Brush.AccentSoft}"
                                        CornerRadius="6" Padding="8,2">
                                    <TextBlock Text="{Binding ShortcutLockActive}" FontSize="11"
                                               Foreground="{DynamicResource Brush.Accent}" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ===== 数据 ===== -->
                    <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=settings.data}" Style="{StaticResource Text.Section}" Margin="2,4,0,8" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,9">
                                <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=settings.entitlement}" FontSize="12.5" Foreground="{DynamicResource Brush.Ink}" />
                                <TextBlock Text="{Binding EntitlementText}"
                                           HorizontalAlignment="Right"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource Brush.Accent}" />
                            </Grid>
                            <Grid Margin="0,0,0,9">
                                <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=settings.stats}" FontSize="12.5" Foreground="{DynamicResource Brush.Ink}" />
                                <TextBlock Text="{Binding StatsText}"
                                           HorizontalAlignment="Right"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource Brush.InkSoft}" />
                            </Grid>
                            <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=settings.storage}" FontSize="12.5" Foreground="{DynamicResource Brush.Ink}" Margin="0,0,0,4" />
                            <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="7" Padding="9,7">
                                <TextBlock Text="{Binding DataPathText}"
                                           FontSize="10.5"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.InkSoft}" />
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="0,1,0,0"
                    Padding="18,10"
                    Background="{DynamicResource Brush.PaperDeep}"
                    CornerRadius="0,0,13,13">
                <TextBlock Text="{Binding Converter={StaticResource Loc}, ConverterParameter=settings.autoSaved}"
                           Style="{StaticResource Text.Caption}" />
            </Border>
        </Grid>
    </Border>
</Window>
